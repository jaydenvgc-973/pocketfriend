    {
      "function_name": "vickRunDiagnostic",
      "description": "Runs live authoritative diagnostics against the account database. Returns structured diagnosticStatus including status (completed/failed/timed_out/rate_limited/permission_denied/no_matching_records/partial), freshness (live/snapshot), error_code, error_message, findings, warnings, and errors. Use for all diagnostic, audit, roster, and investigation requests. Never treat a non-completed status as missing data."
    },
    {
      "function_name": "vickInvestigationBridge",
      "description": "Runs a cross-referenced investigation combining database records, frontend resolver state, schedule state, and roster data. Returns structured diagnosticStatus with freshness labels (live vs snapshot), contradiction detection, and source availability ledger. Use when investigating character state, location contradictions, or account-wide issues. Always surface the diagnosticStatus fields to the user."
    }
  ],
