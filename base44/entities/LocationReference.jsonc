{
  "name": "LocationReference",
  "type": "object",
  "required": [
    "name",
    "location_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.scope": "shared"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "properties": {
    "name": {
      "type": "string",
      "description": "The display name of the location (e.g. 'Jayden's Apartment', 'The Coffee House')"
    },
    "location_type": {
      "type": "string",
      "enum": [
        "global",
        "character_specific",
        "shared"
      ],
      "default": "global",
      "description": "Legacy field \u2014 kept for backwards compatibility. Use scope instead."
    },
    "scope": {
      "type": "string",
      "enum": [
        "shared",
        "account_global",
        "character_specific"
      ],
      "default": "account_global"
    },
    "owner_user_id": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "created_by_role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ]
    },
    "assigned_character_id": {
      "type": "string"
    },
    "assigned_character_name": {
      "type": "string"
    },
    "source_shared_location_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "home",
        "workplace",
        "gym",
        "social",
        "outdoor",
        "food_drink",
        "medical",
        "education",
        "grocery",
        "religion",
        "government",
        "public",
        "business",
        "school",
        "community",
        "generic"
      ],
      "default": "generic"
    },
    "subtype": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "is_real_world": {
      "type": "boolean",
      "default": false
    },
    "source": {
      "type": "string",
      "enum": [
        "app_created",
        "travel_input",
        "import"
      ],
      "default": "app_created"
    },
    "is_rabbit_hole": {
      "type": "boolean",
      "default": false
    },
    "is_system_managed": {
      "type": "boolean",
      "default": false,
      "description": "True if location is system-created (e.g., temporary housing)"
    },
    "system_location_role": {
      "type": "string",
      "enum": [
        "temporary_hotel",
        "emergency_shelter"
      ],
      "nullable": true,
      "description": "Stable system identifier for predefined locations. Names can change; this field defines identity."
    },
    "school_type": {
      "type": "string",
      "enum": [
        "high_school",
        "college",
        "university",
        "trade_school",
        "private_school",
        "language_school",
        "music_school",
        "online_school",
        "other"
      ]
    },
    "community_type": {
      "type": "string",
      "enum": [
        "community_center",
        "drop_in_center",
        "after_school_program",
        "daycare",
        "youth_center",
        "resource_hub",
        "other"
      ]
    },
    "tuition_cost": {
      "type": "number",
      "default": 0
    },
    "tuition_frequency": {
      "type": "string",
      "enum": [
        "annual",
        "semester",
        "monthly",
        "per_course"
      ],
      "default": "annual"
    },
    "enrolled_students": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "character_id": {
            "type": "string"
          },
          "character_name": {
            "type": "string"
          },
          "tuition_amount": {
            "type": "number"
          },
          "scholarship_enabled": {
            "type": "boolean",
            "default": false
          },
          "enroll_date": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended",
              "graduated",
              "dropped"
            ],
            "default": "active"
          }
        }
      },
      "default": []
    },
    "character_id": {
      "type": "string"
    },
    "character_name": {
      "type": "string"
    },
    "owner_character_id": {
      "type": "string"
    },
    "owner_character_name": {
      "type": "string"
    },
    "owner_is_npc": {
      "type": "boolean",
      "default": false
    },
    "owner_npc_name": {
      "type": "string"
    },
    "owner_role": {
      "type": "string"
    },
    "religion_denomination": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "zone_name": {
            "type": "string"
          },
          "zone_description": {
            "type": "string"
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "zone_name"
        ]
      }
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legacy flat image list"
    },
    "resident_character_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "DEPRECATED: Use residents array instead"
    },
    "resident_character_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "DEPRECATED: Use residents array instead"
    },
    "residents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "character_id": {
            "type": "string"
          },
          "character_name": {
            "type": "string"
          },
          "avatar_url": {
            "type": "string"
          },
          "moved_in_date": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "character_id",
          "character_name"
        ]
      },
      "default": []
    },
    "resident_family_members": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "relationship_type": {
            "type": "string"
          },
          "source_character_id": {
            "type": "string"
          },
          "isNPC": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "resident_housing_context": {
      "type": "object",
      "description": "Maps character_id to their housing context at this location: 'homeless' or 'shelter'",
      "additionalProperties": {
        "type": "string"
      }
    },
    "worker_character_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "worker_pay_rates": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "worker_pay_type": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "worker_job_titles": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "worker_shifts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "days": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      }
    },
    "operating_hours": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day_of_week": {
            "type": "integer"
          },
          "open_time": {
            "type": "string"
          },
          "close_time": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "open_time",
          "close_time"
        ]
      }
    },
    "vip_access": {
      "type": "object",
      "properties": {
        "has_vip": {
          "type": "boolean",
          "default": false
        },
        "vip_access_rules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "vip_cost": {
          "type": "number"
        }
      }
    },
    "club_theme": {
      "type": "string"
    },
    "venue_identity": {
      "type": "string"
    },
    "utility_costs": {
      "type": "object",
      "properties": {
        "electricity": {
          "type": "number"
        },
        "water": {
          "type": "number"
        },
        "gas": {
          "type": "number"
        },
        "internet": {
          "type": "number"
        },
        "other": {
          "type": "number"
        }
      }
    },
    "rent_or_housing_cost": {
      "type": "number"
    },
    "monthly_childcare_cost": {
      "type": "number"
    },
    "bedroom_count": {
      "type": "integer",
      "default": 1
    },
    "gym_membership_fee": {
      "type": "number"
    },
    "gym_members": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "grocery_household_size": {
      "type": "integer"
    },
    "grocery_average_spend": {
      "type": "number"
    },
    "operating_cost": {
      "type": "number"
    },
    "cost_split_method": {
      "type": "string",
      "enum": [
        "even",
        "custom"
      ],
      "default": "even"
    },
    "resident_cost_split": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "income_generated": {
      "type": "number"
    },
    "last_income_updated": {
      "type": "string",
      "format": "date-time"
    },
    "is_default_generic": {
      "type": "boolean",
      "default": false
    },
    "generic_type": {
      "type": "string",
      "enum": [
        "park",
        "hospital",
        "grocery",
        "worship"
      ]
    },
    "generic_type_label": {
      "type": "string",
      "enum": [
        "park",
        "hospital",
        "grocery",
        "worship"
      ]
    },
    "canonical_location_key": {
      "type": "string"
    },
    "is_generic_shared": {
      "type": "boolean",
      "default": false
    },
    "is_user_created": {
      "type": "boolean",
      "default": true
    }
  }
}