{
  "name": "LocationReference",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The display name of the location (e.g. 'Jayden's Apartment', 'Downtown Coffee Shop')"
    },
    "location_type": {
      "type": "string",
      "enum": [
        "global",
        "character_specific"
      ],
      "default": "global",
      "description": "Whether this location is shared across all characters or specific to one"
    },
    "character_id": {
      "type": "string",
      "description": "If character_specific, the ID of the character this belongs to"
    },
    "character_name": {
      "type": "string",
      "description": "Display name of the character if character_specific"
    },
    "owner_character_id": {
      "type": "string",
      "description": "ID of the active character who owns/operates this location (landlord, manager, revenue earner). For global spaces this may be reassigned if the owner is deleted."
    },
    "owner_character_name": {
      "type": "string",
      "description": "Display name of the owning character or NPC"
    },
    "owner_is_npc": {
      "type": "boolean",
      "default": false,
      "description": "True if the owner is an NPC (no linked character record) rather than an active character"
    },
    "owner_npc_name": {
      "type": "string",
      "description": "Free-text name of the NPC owner if owner_is_npc is true"
    },
    "owner_role": {
      "type": "string",
      "description": "The owner's role at this location, e.g. 'landlord', 'manager', 'owner', 'operator'"
    },
    "category": {
      "type": "string",
      "enum": [
        "home",
        "workplace",
        "gym",
        "social",
        "outdoor",
        "food_drink",
        "medical",
        "education",
        "grocery",
        "religion",
        "government",
        "public",
        "business",
        "school",
        "generic"
      ],
      "default": "generic",
      "description": "Category for grouping and matching"
    },
    "description": {
      "type": "string",
      "description": "Optional description of the location's overall style, layout, or atmosphere"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Keywords used to detect when a character is at this location"
    },
    "zones": {
      "type": "array",
      "description": "Room/zone breakdown \u2014 each zone has its own reference images",
      "items": {
        "type": "object",
        "properties": {
          "zone_name": {
            "type": "string",
            "description": "The name of the room or zone (e.g. 'Kitchen', 'Locker Room', 'Patient Room')"
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Reference images for this specific zone (4-5 recommended)"
          }
        },
        "required": [
          "zone_name"
        ]
      }
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legacy flat image list \u2014 kept for backwards compatibility only. Prefer zones."
    },
    "resident_character_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of characters who live at this location (for residential locations)"
    },
    "resident_character_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Display names of residents for quick reference"
    },
    "worker_character_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of characters who work at this location"
    },
    "worker_pay_rates": {
      "type": "object",
      "description": "Pay rates by character_id (e.g. { 'char_123': 15.00, 'char_456': 20.00 })",
      "additionalProperties": {
        "type": "number"
      }
    },
    "worker_pay_type": {
      "type": "object",
      "description": "Pay type by character_id ('hourly' or 'annual') (e.g. { 'char_123': 'hourly', 'char_456': 'annual' })",
      "additionalProperties": {
        "type": "string"
      }
    },
    "worker_job_titles": {
      "type": "object",
      "description": "Job title by character_id (e.g. { 'char_123': 'Manager', 'char_456': 'Barista' })",
      "additionalProperties": {
        "type": "string"
      }
    },
    "operating_hours": {
      "type": "array",
      "description": "Operating hours / active hours for the location. Multiple windows allowed for varied schedules.",
      "items": {
        "type": "object",
        "properties": {
          "day_of_week": {
            "type": "integer",
            "description": "0=Sunday, 6=Saturday. If null, applies to all days."
          },
          "open_time": {
            "type": "string",
            "description": "Opening time in HH:MM format (24h)"
          },
          "close_time": {
            "type": "string",
            "description": "Closing time in HH:MM format (24h)"
          },
          "note": {
            "type": "string",
            "description": "Optional label like 'Morning Service' or 'Sunday Only'"
          }
        },
        "required": [
          "open_time",
          "close_time"
        ]
      }
    },
    "utility_costs": {
      "type": "object",
      "description": "Monthly utility costs (in USD)",
      "properties": {
        "electricity": {
          "type": "number",
          "description": "Monthly electricity cost in USD"
        },
        "water": {
          "type": "number",
          "description": "Monthly water cost in USD"
        },
        "gas": {
          "type": "number",
          "description": "Monthly gas cost in USD"
        },
        "internet": {
          "type": "number",
          "description": "Monthly internet cost in USD"
        },
        "other": {
          "type": "number",
          "description": "Other utility costs in USD"
        }
      }
    },
    "rent_or_housing_cost": {
      "type": "number",
      "description": "Monthly rent or housing cost in USD (for residential locations)"
    },
    "bedroom_count": {
      "type": "integer",
      "default": 1,
      "description": "Number of bedrooms in residential location. Affects rent automatically."
    },
    "gym_membership_fee": {
      "type": "number",
      "description": "Monthly gym membership fee in USD (for gym locations)"
    },
    "gym_members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of characters with active gym memberships"
    },
    "grocery_household_size": {
      "type": "integer",
      "description": "Used to calculate grocery costs for residential locations. Defaults to number of active residents."
    },
    "grocery_average_spend": {
      "type": "number",
      "description": "Average monthly grocery spend baseline in USD. Defaults to U.S. average adjusted for household size."
    },
    "operating_cost": {
      "type": "number",
      "description": "Monthly operating cost in USD (for business locations)"
    },
    "cost_split_method": {
      "type": "string",
      "enum": [
        "even",
        "custom"
      ],
      "default": "even",
      "description": "How to split costs among residents: 'even' for equal split, 'custom' for custom amounts"
    },
    "resident_cost_split": {
      "type": "object",
      "description": "Custom cost split by resident (character_id -> amount in USD)",
      "additionalProperties": {
        "type": "number"
      }
    },
    "income_generated": {
      "type": "number",
      "description": "Total income generated at this location (aggregate, for reference)"
    },
    "last_income_updated": {
      "type": "string",
      "format": "date-time",
      "description": "When income was last calculated"
    },
    "is_default_generic": {
      "type": "boolean",
      "default": false,
      "description": "True if this is a default generic location created automatically for a new character"
    },
    "generic_type": {
      "type": "string",
      "enum": [
        "apartment",
        "house",
        "studio",
        "shared_house",
        "dorm"
      ],
      "description": "Type of generic residential location if is_default_generic is true"
    }
  },
  "required": [
    "name",
    "location_type"
  ]
}