{
  "name": "LocationReference",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The display name of the location (e.g. 'Jayden's Apartment', 'The Coffee House')"
    },
    "location_type": {
      "type": "string",
      "enum": [
        "global",
        "character_specific"
      ],
      "default": "global",
      "description": "Whether this location is shared across all characters or specific to one"
    },
    "category": {
      "type": "string",
      "enum": [
        "home",
        "workplace",
        "gym",
        "social",
        "outdoor",
        "food_drink",
        "medical",
        "education",
        "grocery",
        "religion",
        "government",
        "public",
        "business",
        "school",
        "generic"
      ],
      "default": "generic",
      "description": "Broad category for grouping"
    },
    "subtype": {
      "type": "string",
      "enum": [
        "apartment",
        "house",
        "condo",
        "studio",
        "coffee_shop",
        "cafe",
        "diner",
        "lunch_spot",
        "breakfast_spot",
        "fine_dining_restaurant",
        "casual_restaurant",
        "fast_casual",
        "food_truck",
        "pizza_place",
        "sushi_restaurant",
        "steakhouse",
        "taco_stand",
        "burger_joint",
        "bbq_place",
        "ramen_shop",
        "thai_restaurant",
        "mexican_restaurant",
        "italian_restaurant",
        "asian_fusion",
        "vegan_restaurant",
        "gastropub",
        "cocktail_bar",
        "dive_bar",
        "sports_bar",
        "beer_hall",
        "gay_bar",
        "lesbian_bar",
        "queer_bar",
        "upscale_lounge",
        "neighborhood_bar",
        "wine_bar",
        "tiki_bar",
        "house_music_club",
        "hip_hop_club",
        "electronic_club",
        "punk_venue",
        "rock_venue",
        "latin_dance_club",
        "country_bar",
        "jazz_club",
        "karaoke_bar",
        "nightclub",
        "dance_club",
        "rave_venue",
        "rooftop_bar",
        "lounge_club",
        "gym",
        "yoga_studio",
        "pilates_studio",
        "crossfit_box",
        "swimming_pool",
        "park",
        "hiking_trail",
        "beach",
        "lake",
        "river",
        "botanical_garden",
        "urban_plaza",
        "grocery_store",
        "supermarket",
        "farmers_market",
        "convenience_store",
        "pharmacy",
        "clothing_store",
        "bookstore",
        "record_store",
        "electronics_store",
        "home_goods_store",
        "thrift_store",
        "mall",
        "shopping_district",
        "office",
        "corporate_office",
        "startup_office",
        "factory",
        "warehouse",
        "retail_store",
        "salon",
        "barbershop",
        "hospital",
        "clinic",
        "urgent_care",
        "dentist_office",
        "therapist_office",
        "university",
        "college",
        "high_school",
        "elementary_school",
        "library",
        "classroom",
        "church",
        "temple",
        "mosque",
        "synagogue",
        "meditation_center",
        "community_center",
        "museum",
        "art_gallery",
        "theater",
        "cinema",
        "concert_venue",
        "sports_arena",
        "stadium",
        "government_office",
        "police_station",
        "courthouse",
        "city_hall",
        "park_ranger_station"
      ],
      "description": "Specific venue subtype that controls menu, actions, NPCs, and tone",
      "default": ""
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Location features that affect actions and capabilities. Examples: ['VIP', 'dance floor', 'DJ', 'dine-in', 'takeout', 'alcohol', 'dress code']",
      "default": []
    },
    "character_id": {
      "type": "string",
      "description": "If character_specific, the ID of the character this belongs to"
    },
    "character_name": {
      "type": "string",
      "description": "Display name of the character if character_specific"
    },
    "owner_character_id": {
      "type": "string",
      "description": "ID of the active character who owns/operates this location"
    },
    "owner_character_name": {
      "type": "string",
      "description": "Display name of the owning character or NPC"
    },
    "owner_is_npc": {
      "type": "boolean",
      "default": false,
      "description": "True if the owner is an NPC rather than an active character"
    },
    "owner_npc_name": {
      "type": "string",
      "description": "Free-text name of the NPC owner if owner_is_npc is true"
    },
    "owner_role": {
      "type": "string",
      "description": "The owner's role at this location, e.g. 'landlord', 'manager', 'owner', 'operator'"
    },
    "religion_denomination": {
      "type": "string",
      "enum": [
        "Christianity",
        "Catholicism",
        "Islam",
        "Judaism",
        "Hinduism",
        "Buddhism",
        "Sikhism",
        "Jehovah's Witnesses",
        "Seventh-day Adventist",
        "Baptist",
        "Pentecostal",
        "Non-denominational",
        "Other"
      ],
      "description": "The religion or denomination associated with this place of worship (for category=religion only)"
    },
    "description": {
      "type": "string",
      "description": "Optional description of the location's overall style, layout, or atmosphere"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Keywords used to detect when a character is at this location"
    },
    "zones": {
      "type": "array",
      "description": "Room/zone breakdown \u2014 each zone has its own reference images and action context",
      "items": {
        "type": "object",
        "properties": {
          "zone_name": {
            "type": "string"
          },
          "zone_description": {
            "type": "string",
            "description": "What this zone is like, affects actions and NPC behavior"
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "zone_name"
        ]
      }
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legacy flat image list \u2014 kept for backwards compatibility only. Prefer zones."
    },
    "resident_character_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of characters who live at this location"
    },
    "resident_character_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Display names of residents for quick reference"
    },
    "worker_character_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of characters who work at this location"
    },
    "worker_pay_rates": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "worker_pay_type": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "worker_job_titles": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "worker_shifts": {
      "type": "object",
      "description": "Shift times and days for each worker by worker ID",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "description": "Shift start time (HH:MM format)"
          },
          "end": {
            "type": "string",
            "description": "Shift end time (HH:MM format)"
          },
          "days": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Days of week worked (0=Sunday, 6=Saturday)"
          }
        }
      }
    },
    "operating_hours": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day_of_week": {
            "type": "integer"
          },
          "open_time": {
            "type": "string"
          },
          "close_time": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "open_time",
          "close_time"
        ]
      }
    },
    "vip_access": {
      "type": "object",
      "description": "VIP system configuration",
      "properties": {
        "has_vip": {
          "type": "boolean",
          "default": false,
          "description": "Whether this location has a VIP area"
        },
        "vip_access_rules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "How to gain VIP access: 'pay', 'invite', 'sneak', 'connection', 'status'",
          "default": []
        },
        "vip_cost": {
          "type": "number",
          "description": "Cost to access VIP if applicable"
        }
      }
    },
    "club_theme": {
      "type": "string",
      "enum": [
        "House",
        "90s R&B",
        "Hip Hop",
        "Punk",
        "Rock",
        "Latin",
        "EDM",
        "Afrobeats",
        "Trap",
        "Throwback",
        "Alternative",
        "Techno",
        "Disco",
        "Country",
        "Jazz",
        "Reggae",
        "K-pop",
        "Indie",
        "Metal",
        "Pop",
        "R&B",
        "Soul",
        "Funk",
        "Dub",
        "Drum and Bass",
        "Dubstep",
        "Garage",
        "Grime",
        "Trance",
        "Deep House",
        "Minimal",
        "Experimental",
        ""
      ],
      "description": "Music/theme for clubs and bars"
    },
    "venue_identity": {
      "type": "string",
      "enum": [
        "gay bar",
        "lesbian bar",
        "queer bar",
        "inclusive nightlife",
        "straight bar",
        "dive bar",
        "sports bar",
        "upscale lounge",
        "neighborhood bar",
        ""
      ],
      "description": "Social identity/vibe of bar/club venues"
    },
    "utility_costs": {
      "type": "object",
      "properties": {
        "electricity": {
          "type": "number"
        },
        "water": {
          "type": "number"
        },
        "gas": {
          "type": "number"
        },
        "internet": {
          "type": "number"
        },
        "other": {
          "type": "number"
        }
      }
    },
    "rent_or_housing_cost": {
      "type": "number"
    },
    "bedroom_count": {
      "type": "integer",
      "default": 1
    },
    "gym_membership_fee": {
      "type": "number"
    },
    "gym_members": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "grocery_household_size": {
      "type": "integer"
    },
    "grocery_average_spend": {
      "type": "number"
    },
    "operating_cost": {
      "type": "number"
    },
    "cost_split_method": {
      "type": "string",
      "enum": [
        "even",
        "custom"
      ],
      "default": "even"
    },
    "resident_cost_split": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "income_generated": {
      "type": "number"
    },
    "last_income_updated": {
      "type": "string",
      "format": "date-time"
    },
    "is_default_generic": {
      "type": "boolean",
      "default": false,
      "description": "True if this is one of the canonical shared generic locations"
    },
    "generic_type": {
      "type": "string",
      "enum": [
        "park",
        "hospital",
        "grocery",
        "worship"
      ],
      "description": "Identifies which generic location type this is (if any)"
    },
    "generic_type_label": {
      "type": "string",
      "enum": [
        "park",
        "hospital",
        "grocery",
        "worship"
      ],
      "description": "Display label for the generic type"
    },
    "canonical_location_key": {
      "type": "string",
      "description": "Stable canonical identity key for generic locations (e.g. generic_grocery_store, generic_park)"
    },
    "is_generic_shared": {
      "type": "boolean",
      "default": false,
      "description": "True if this is a shared generic world location that should never be duplicated"
    },
    "is_user_created": {
      "type": "boolean",
      "default": true,
      "description": "True if this location was explicitly created by the user, false if system-assigned"
    }
  },
  "required": [
    "name",
    "location_type"
  ]
}