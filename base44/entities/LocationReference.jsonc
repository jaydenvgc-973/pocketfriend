{
  "name": "LocationReference",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The display name of the location (e.g. 'Jayden's Apartment', 'Downtown Coffee Shop')"
    },
    "location_type": {
      "type": "string",
      "enum": [
        "global",
        "character_specific"
      ],
      "default": "global",
      "description": "Whether this location is shared across all characters or specific to one"
    },
    "character_id": {
      "type": "string",
      "description": "If character_specific, the ID of the character this belongs to"
    },
    "character_name": {
      "type": "string",
      "description": "Display name of the character if character_specific"
    },
    "category": {
      "type": "string",
      "enum": [
        "home",
        "workplace",
        "gym",
        "social",
        "outdoor",
        "food_drink",
        "medical",
        "education",
        "other"
      ],
      "default": "other",
      "description": "Category for grouping and matching"
    },
    "description": {
      "type": "string",
      "description": "Optional description of the location's overall style, layout, or atmosphere"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Keywords used to detect when a character is at this location"
    },
    "zones": {
      "type": "array",
      "description": "Room/zone breakdown \u2014 each zone has its own reference images",
      "items": {
        "type": "object",
        "properties": {
          "zone_name": {
            "type": "string",
            "description": "The name of the room or zone (e.g. 'Kitchen', 'Locker Room', 'Patient Room')"
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Reference images for this specific zone (4-5 recommended)"
          }
        },
        "required": [
          "zone_name"
        ]
      }
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legacy flat image list \u2014 kept for backwards compatibility only. Prefer zones."
    }
  },
  "required": [
    "name",
    "location_type"
  ]
}