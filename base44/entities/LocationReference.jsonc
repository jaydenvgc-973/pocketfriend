{
  "name": "LocationReference",
  "type": "object",
  "required": [
    "name",
    "location_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.scope": "shared"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "properties": {
    "name": {
      "type": "string"
    },
    "location_type": {
      "type": "string",
      "enum": [
        "global",
        "character_specific",
        "shared",
        "destination"
      ],
      "default": "global"
    },
    "scope": {
      "type": "string",
      "enum": [
        "shared",
        "account_global",
        "character_specific"
      ],
      "default": "account_global"
    },
    "owner_user_id": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "created_by_role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ]
    },
    "is_system_managed": {
      "type": "boolean",
      "default": false
    },
    "system_location_role": {
      "type": "string",
      "enum": [
        "temporary_hotel",
        "emergency_shelter"
      ]
    },
    "assigned_character_id": {
      "type": "string"
    },
    "assigned_character_name": {
      "type": "string"
    },
    "source_shared_location_id": {
      "type": "string"
    },
    "geo-mode": {
      "type": "string",
      "enum": [
        "real_world",
        "app_world",
        "hybrid"
      ]
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "map_x": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "map_y": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "anchor_city": {
      "type": "string"
    },
    "anchor_state": {
      "type": "string"
    },
    "fictional_region": {
      "type": "string"
    },
    "map_zone": {
      "type": "string"
    },
    "same_building_group_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "home",
        "hotel",
        "shelter",
        "workplace",
        "gym",
        "social",
        "outdoor",
        "food_drink",
        "medical",
        "education",
        "grocery",
        "religion",
        "government",
        "public",
        "business",
        "school",
        "community",
        "generic",
        "jail_prison",
        "transportation"
      ],
      "default": "generic"
    },
    "is_confinement_facility": {
      "type": "boolean",
      "default": false
    },
    "confinement_type": {
      "type": "string",
      "enum": [
        "jail",
        "prison",
        "detention_center",
        "correctional_facility",
        "juvenile_detention",
        "halfway_house",
        "holding_cell",
        "confinement_facility",
        "pretrial_detention",
        "adult_detention",
        "immigration_detention",
        "house_arrest_residence"
      ]
    },
    "confinement_security_level": {
      "type": "string",
      "enum": [
        "minimum",
        "low",
        "medium",
        "maximum"
      ]
    },
    "confinement_jurisdiction": {
      "type": "string"
    },
    "confinement_capacity": {
      "type": "integer"
    },
    "allows_visitation": {
      "type": "boolean",
      "default": true
    },
    "visitation_hours": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day_of_week": {
            "type": "integer"
          },
          "open_time": {
            "type": "string"
          },
          "close_time": {
            "type": "string"
          }
        }
      }
    },
    "correctional_attire": {
      "type": "object",
      "additionalProperties": true
    },
    "uniforms": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "applicability": {
            "type": "string",
            "enum": [
              "job_title",
              "role_status",
              "zone",
              "location_wide",
              "generic_staff"
            ]
          },
          "job_title": {
            "type": "string"
          },
          "role_status": {
            "type": "string"
          },
          "zone": {
            "type": "string"
          }
        }
      }
    },
    "worker_manual_uniforms": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "inmates": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "character_id": {
            "type": "string"
          },
          "character_name": {
            "type": "string"
          },
          "charges": {
            "type": "string"
          },
          "booking_date": {
            "type": "string",
            "format": "date"
          },
          "confinement_status": {
            "type": "string",
            "enum": [
              "pretrial",
              "sentenced",
              "held",
              "work_release",
              "solitary",
              "released"
            ]
          },
          "sentence_days": {
            "type": "integer"
          },
          "expected_release_date": {
            "type": "string",
            "format": "date"
          },
          "actual_release_date": {
            "type": "string",
            "format": "date"
          },
          "confined_at": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "character_id",
          "character_name",
          "charges",
          "booking_date"
        ]
      }
    },
    "subtype": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "is_real_world": {
      "type": "boolean",
      "default": false
    },
    "source": {
      "type": "string",
      "enum": [
        "app_created",
        "travel_input",
        "import"
      ],
      "default": "app_created"
    },
    "is_rabbit_hole": {
      "type": "boolean",
      "default": false
    },
    "school_type": {
      "type": "string",
      "enum": [
        "daycare_preschool",
        "elementary_school",
        "high_school",
        "boarding_school",
        "college",
        "university",
        "trade_school",
        "private_school",
        "language_school",
        "music_school",
        "online_school",
        "other"
      ],
      "description": "Type of school. Determines residency rules: daycare_preschool/elementary_school/high_school = non-residential; boarding_school = always residential; college/university = residential or non-residential (user choice)."
    },
    "community_type": {
      "type": "string",
      "enum": [
        "community_center",
        "drop_in_center",
        "after_school_program",
        "daycare",
        "youth_center",
        "resource_hub",
        "other"
      ]
    },
    "tuition_cost": {
      "type": "number",
      "default": 0
    },
    "tuition_frequency": {
      "type": "string",
      "enum": [
        "annual",
        "semester",
        "monthly",
        "per_course"
      ],
      "default": "annual"
    },
    "enrolled_students": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "character_id": {
            "type": "string"
          },
          "character_name": {
            "type": "string"
          },
          "tuition_amount": {
            "type": "number"
          },
          "scholarship_enabled": {
            "type": "boolean",
            "default": false
          },
          "enroll_date": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended",
              "graduated",
              "dropped"
            ],
            "default": "active"
          }
        }
      }
    },
    "religious_members": {
      "type": "array",
      "default": [],
      "description": "Characters assigned as congregation members. Shared truth with Character.religious_location_id.",
      "items": {
        "type": "object",
        "properties": {
          "character_id": {
            "type": "string"
          },
          "character_name": {
            "type": "string"
          },
          "joined_date": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "character_id",
          "character_name"
        ]
      }
    },
    "character_id": {
      "type": "string"
    },
    "character_name": {
      "type": "string"
    },
    "owner_character_id": {
      "type": "string"
    },
    "owner_character_name": {
      "type": "string"
    },
    "owner_is_npc": {
      "type": "boolean",
      "default": false
    },
    "owner_npc_name": {
      "type": "string"
    },
    "owner_role": {
      "type": "string"
    },
    "leadership_assignments": {
      "type": "array",
      "default": [],
      "description": "Additional leadership or management roles at this place, each with its own role label and its own person. A Generic parent offers the roles its Parent Location Type establishes (a city's Mayor, a country's President or Monarch, a building's Property Manager). Never created automatically and never shared with the ownership of any child place: the parent's mayor is not the landlord of the apartments inside it.",
      "items": {
        "type": "object",
        "properties": {
          "assignment_id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "description": "The role exactly as chosen for this place (e.g. Mayor, Deputy Mayor, Prime Minister, Property Manager)."
          },
          "character_id": {
            "type": "string"
          },
          "character_name": {
            "type": "string"
          },
          "is_npc": {
            "type": "boolean",
            "default": false
          },
          "npc_name": {
            "type": "string"
          }
        },
        "required": [
          "assignment_id",
          "role"
        ]
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner_is_npc_name": {
      "type": "string"
    },
    "religion_denomination": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "zone_name": {
            "type": "string"
          },
          "zone_description": {
            "type": "string"
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "is_primary_category": {
            "type": "boolean",
            "default": false,
            "description": "True only when the user explicitly marked this zone as part of the location's main selected category. Set by the user in the zone image references \u2014 never inferred from the zone name, description, or category."
          }
        },
        "required": [
          "zone_name"
        ]
      }
    },
    "environments": {
      "type": "array",
      "description": "Explicit user-configured environments for mixed-use locations. Each environment is user-defined \u2014 never inferred from zone names, category, or any other heuristic. A location has mixed-use environments ONLY when this array is non-empty. A residential environment is one configured residence; a property may hold several, each with its own name, spaces, people and reference images.",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique stable ID for this environment (e.g. uuid or slug)"
          },
          "name": {
            "type": "string",
            "description": "User-facing environment name (e.g. 'Business Operations', 'North Campus Quarters')"
          },
          "type": {
            "type": "string",
            "enum": [
              "operational",
              "residential",
              "restricted",
              "community"
            ],
            "description": "operational = subject to business hours; residential = always available regardless of business hours, sleep-eligible; restricted = suppresses general ambient population, scene built from user + companions + explicitly included + contextually required occupants only; community = communal/social space, sleep-eligible, follows business hours by default"
          },
          "follows_business_hours": {
            "type": "boolean",
            "default": true,
            "description": "When true, this environment respects the location operating_hours. When false (residential), travel is never blocked by hours."
          },
          "physical_setting": {
            "type": "string",
            "enum": [
              "indoor",
              "outdoor"
            ],
            "description": "Whether this environment is physically indoors or outdoors. Independent of the parent property, its category and its Environment type. Empty when the user has not designated it \u2014 never inferred."
          },
          "zone_names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Zone names from the location zones array that belong to this environment. User-assigned, never auto-classified. A residence keeps every space chosen for it \u2014 one residence selecting a room never removes another residence's rooms."
          },
          "occupant_character_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Canonical character IDs assigned to THIS residence. A person living in one residence is never treated as living in another residence of the same property."
          },
          "residence_type": {
            "type": "string",
            "description": "The kind of residence the user designated for this space (e.g. apartment, house, dorm room, sleeping area). Free text chosen by the user \u2014 never inferred from the environment name."
          },
          "zone_images": {
            "type": "array",
            "default": [],
            "description": "Reference images generated or uploaded for THIS residence's own spaces, each keeping the zone name it belongs to. The same image URLs are also part of the parent location's zone image_urls, so the existing Scenes reference usage is unchanged. Two residences that both have a Living Room keep their own pictures here.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "zone_name": {
                  "type": "string",
                  "description": "The zone of the parent property this image belongs to"
                },
                "url": {
                  "type": "string",
                  "description": "The image URL, also present in that parent zone's image_urls"
                }
              },
              "required": [
                "zone_name",
                "url"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "zone_names"
        ]
      }
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resident_character_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resident_character_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "residents": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "character_id": {
            "type": "string"
          },
          "character_name": {
            "type": "string"
          },
          "avatar_url": {
            "type": "string"
          },
          "moved_in_date": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "character_id",
          "character_name"
        ]
      }
    },
    "resident_family_members": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "relationship_type": {
            "type": "string"
          },
          "source_character_id": {
            "type": "string"
          },
          "isNPC": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "resident_housing_context": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "residential_units": {
      "type": "array",
      "default": [],
      "description": "User-configured residences inside one property: apartments in a building, houses, dorm rooms, patient rooms, cells, and the areas of an encampment. Each residence is its own space with its own household and its own rooms \u2014 a residence is never limited to a single zone. Residents assigned to a residence remain residents of the parent property; residents not assigned to any remain unassigned property residents.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "unit_id": {
            "type": "string",
            "description": "Stable unique ID for this residence (UUID or slug)"
          },
          "unit_name": {
            "type": "string",
            "description": "User-defined residence name or number (e.g. 'Apartment 1', 'Unit 4B', 'Underpass Encampment')"
          },
          "occupant_character_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Canonical character IDs assigned as occupants of this residence. These characters form a household within the property."
          },
          "zone_name": {
            "type": "string",
            "description": "The primary space this residence is shown as \u2014 the first of its zone_names, kept in sync so every existing reader is unchanged. Never inferred from the residence name."
          },
          "zone_names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Every space of this residence, in the user's order \u2014 an apartment's living room, kitchen, bedroom, bathroom; an encampment's tent, bridge, sidewalk. One residence selecting a room never removes another residence's rooms."
          },
          "zone_images": {
            "type": "array",
            "default": [],
            "description": "Reference images generated or uploaded for THIS residence's own spaces, each keeping the zone name it belongs to. The same image URLs are also part of the parent location's zone image_urls, so existing reference usage is unchanged. Two residences that both have a Living Room keep their own pictures here.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "zone_name": {
                  "type": "string",
                  "description": "The zone of the parent property this image belongs to"
                },
                "url": {
                  "type": "string",
                  "description": "The image URL, also present in that parent zone's image_urls"
                }
              },
              "required": [
                "zone_name",
                "url"
              ]
            }
          },
          "residence_type": {
            "type": "string",
            "description": "The kind of residence the user designated for this space (e.g. apartment, house, dorm room, sleeping area). Free text chosen by the user \u2014 never inferred from the residence name."
          },
          "physical_setting": {
            "type": "string",
            "enum": [
              "indoor",
              "outdoor"
            ],
            "description": "Whether this residence is physically indoors or outdoors. Independent of the property it belongs to. Empty when the user has not designated it \u2014 never inferred."
          },
          "living_space_kind": {
            "type": "string",
            "enum": [
              "residence",
              "unhoused_living_space"
            ],
            "description": "Which kind of living arrangement this space is. residence = a conventional home (apartment, house, dorm room). unhoused_living_space = an independently configured outdoor living space such as an encampment or underpass, whose occupants remain unhoused. Units saved before this field existed are conventional residences unless the location itself is an Unhoused Living Space."
          }
        },
        "required": [
          "unit_id",
          "unit_name"
        ]
      }
    },
    "venue_types": {
      "type": "array",
      "default": [],
      "description": "Additional venue capabilities explicitly enabled on this location without changing its category. 'workplace' = the property may contain individual businesses inside it. Empty on every location that has none.",
      "items": {
        "type": "string"
      }
    },
    "parent_location_type": {
      "type": "string",
      "description": "Generic parents only. What the parent itself is \u2014 city, town, village, neighborhood, district, slum, state, country, campus, building, property, complex, other. It describes the parent, never one of the child places inside it, and it supplies the parent's own whole-space label in Travel and Scenes. Empty on records saved before it existed, and never inferred as a building.",
      "enum": [
        "city",
        "town",
        "village",
        "neighborhood",
        "district",
        "slum",
        "state",
        "country",
        "campus",
        "building",
        "property",
        "complex",
        "other"
      ]
    },
    "additional_categories": {
      "type": "array",
      "default": [],
      "description": "Generic parents only. The kinds of independently functioning child places this parent may contain, using the app's existing location category values (home, business, medical, outdoor, \u2026). It decides which venue types and management sections are offered for child places. It never changes the parent's own category, and an empty list means no restriction was recorded \u2014 every existing capability is kept.",
      "items": {
        "type": "string"
      }
    },
    "physical_setting": {
      "type": "string",
      "enum": [
        "indoor",
        "outdoor"
      ],
      "description": "Whether this place is physically indoors or outdoors. Independent of category, venue type, Environment and any parent location. Empty on records that predate the field \u2014 never inferred."
    },
    "workplaces": {
      "type": "array",
      "default": [],
      "description": "Individual businesses operating inside this location, each its own establishment with its own name, business types, zones and employees. Never a location of its own: the property keeps its category, residents and units, and its employees are the same workers listed in worker_character_ids \u2014 the existing employment records, shifts and schedules remain the single authority.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "business_types": {
            "type": "array",
            "default": [],
            "description": "Every business type this establishment carries, in the order the user selected them. The first entry is the business's primary type and is mirrored into business_category and business_type, which stay the single authority everywhere else in the app. Selecting a second type never removes the first.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "category": {
                  "type": "string",
                  "description": "The existing location category this type belongs to (e.g. food_drink, business, gym)"
                },
                "type": {
                  "type": "string",
                  "description": "The business's venue type within that category (e.g. casual_restaurant, shoe_store)"
                }
              },
              "required": [
                "category",
                "type"
              ]
            }
          },
          "workplace_id": {
            "type": "string",
            "description": "Stable unique ID for this business (UUID or slug)"
          },
          "name": {
            "type": "string",
            "description": "The business's own name (e.g. 'Ground Floor Restaurant')"
          },
          "description": {
            "type": "string",
            "description": "This business's own description, separate from the parent property's description (e.g. what Agency (NJ) is and does, distinct from Gateway House)."
          },
          "business_category": {
            "type": "string",
            "description": "The existing location category whose functionality this business uses (e.g. food_drink, gym, business)"
          },
          "business_type": {
            "type": "string",
            "description": "The business's existing venue type within that category (e.g. casual_restaurant, yoga_studio, clothing_store)"
          },
          "physical_setting": {
            "type": "string",
            "enum": [
              "indoor",
              "outdoor"
            ],
            "description": "Whether this business or workspace is physically indoors or outdoors. Independent of the parent property: an outdoor patio or loading yard stays connected to its property while operating outdoors. Empty when the user has not designated it \u2014 never inferred."
          },
          "zone_names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Zones of this property that belong to this business"
          },
          "zone_images": {
            "type": "array",
            "default": [],
            "description": "Images generated for THIS business's own zones, each keeping the zone name it belongs to. The same image URLs are also part of the parent location's zone_image_urls, so the existing Scenes reference usage is unchanged.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "zone_name": {
                  "type": "string",
                  "description": "The zone of the parent property this image belongs to"
                },
                "url": {
                  "type": "string",
                  "description": "The generated image URL, also present in that parent zone's image_urls"
                }
              },
              "required": [
                "zone_name",
                "url"
              ]
            }
          },
          "worker_character_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Characters employed by this business. Each one is also listed in the property's worker_character_ids \u2014 the same employment records, schedules and shifts remain the single authority."
          },
          "operating_hours": {
            "type": "array",
            "default": [],
            "description": "This business's own opening hours, in the same shape as the property's operating_hours. They belong to this business alone: a day left without hours is a closed day for this business, and closing it never closes the property or its other businesses or residences. When empty, the business follows the property's existing operating_hours.",
            "items": {
              "type": "object",
              "properties": {
                "day_of_week": {
                  "type": "integer"
                },
                "open_time": {
                  "type": "string"
                },
                "close_time": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "open_time",
                "close_time"
              ]
            }
          }
        },
        "required": [
          "workplace_id",
          "name"
        ]
      }
    },
    "worker_character_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "worker_pay_rates": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "worker_pay_type": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "worker_job_titles": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "worker_shifts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "days": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      }
    },
    "operating_hours": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day_of_week": {
            "type": "integer"
          },
          "open_time": {
            "type": "string"
          },
          "close_time": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "open_time",
          "close_time"
        ]
      }
    },
    "vip_access": {
      "type": "object",
      "properties": {
        "has_vip": {
          "type": "boolean",
          "default": false
        },
        "vip_access_rules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "vip_cost": {
          "type": "number"
        }
      }
    },
    "club_theme": {
      "type": "string"
    },
    "venue_identity": {
      "type": "string"
    },
    "utility_costs": {
      "type": "object",
      "properties": {
        "electricity": {
          "type": "number"
        },
        "water": {
          "type": "number"
        },
        "gas": {
          "type": "number"
        },
        "internet": {
          "type": "number"
        },
        "other": {
          "type": "number"
        }
      }
    },
    "rent_or_housing_cost": {
      "type": "number"
    },
    "nightly_rate": {
      "type": "number"
    },
    "monthly_childcare_cost": {
      "type": "number"
    },
    "bedroom_count": {
      "type": "integer",
      "default": 1
    },
    "gym_membership_fee": {
      "type": "number"
    },
    "gym_members": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "grocery_household_size": {
      "type": "integer"
    },
    "grocery_average_spend": {
      "type": "number"
    },
    "operating_cost": {
      "type": "number"
    },
    "cost_split_method": {
      "type": "string",
      "enum": [
        "even",
        "custom"
      ],
      "default": "even"
    },
    "resident_cost_split": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "income_generated": {
      "type": "number"
    },
    "last_income_updated": {
      "type": "string",
      "format": "date-time"
    },
    "is_default_generic": {
      "type": "boolean",
      "default": false
    },
    "generic_type": {
      "type": "string",
      "enum": [
        "park",
        "hospital",
        "grocery",
        "worship"
      ]
    },
    "generic_type_label": {
      "type": "string",
      "enum": [
        "park",
        "hospital",
        "grocery",
        "worship"
      ]
    },
    "canonical_location_key": {
      "type": "string"
    },
    "is_generic_shared": {
      "type": "boolean",
      "default": false
    },
    "is_user_created": {
      "type": "boolean",
      "default": true
    }
  }
}