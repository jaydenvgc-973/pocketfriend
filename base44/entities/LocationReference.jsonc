{
  "name": "LocationReference",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The display name of the location (e.g. 'Jayden's Apartment', 'Downtown Coffee Shop')"
    },
    "location_type": {
      "type": "string",
      "enum": [
        "global",
        "character_specific"
      ],
      "default": "global",
      "description": "Whether this location is shared across all characters or specific to one"
    },
    "character_id": {
      "type": "string",
      "description": "If character_specific, the ID of the character this belongs to"
    },
    "character_name": {
      "type": "string",
      "description": "Display name of the character if character_specific"
    },
    "owner_character_id": {
      "type": "string",
      "description": "ID of the active character who owns/operates this location"
    },
    "owner_character_name": {
      "type": "string",
      "description": "Display name of the owning character or NPC"
    },
    "owner_is_npc": {
      "type": "boolean",
      "default": false,
      "description": "True if the owner is an NPC rather than an active character"
    },
    "owner_npc_name": {
      "type": "string",
      "description": "Free-text name of the NPC owner if owner_is_npc is true"
    },
    "owner_role": {
      "type": "string",
      "description": "The owner's role at this location, e.g. 'landlord', 'manager', 'owner', 'operator'"
    },
    "category": {
      "type": "string",
      "enum": [
        "home",
        "workplace",
        "gym",
        "social",
        "outdoor",
        "food_drink",
        "medical",
        "education",
        "grocery",
        "religion",
        "government",
        "public",
        "business",
        "school",
        "generic"
      ],
      "default": "generic",
      "description": "Category for grouping and matching"
    },
    "religion_denomination": {
      "type": "string",
      "enum": [
        "Christianity",
        "Catholicism",
        "Islam",
        "Judaism",
        "Hinduism",
        "Buddhism",
        "Sikhism",
        "Jehovah's Witnesses",
        "Seventh-day Adventist",
        "Baptist",
        "Pentecostal",
        "Non-denominational",
        "Other"
      ],
      "description": "The religion or denomination associated with this place of worship (for category=religion only)"
    },
    "description": {
      "type": "string",
      "description": "Optional description of the location's overall style, layout, or atmosphere"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Keywords used to detect when a character is at this location"
    },
    "zones": {
      "type": "array",
      "description": "Room/zone breakdown \u2014 each zone has its own reference images",
      "items": {
        "type": "object",
        "properties": {
          "zone_name": {
            "type": "string"
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "zone_name"
        ]
      }
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legacy flat image list \u2014 kept for backwards compatibility only. Prefer zones."
    },
    "resident_character_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of characters who live at this location"
    },
    "resident_character_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Display names of residents for quick reference"
    },
    "worker_character_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of characters who work at this location"
    },
    "worker_pay_rates": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "worker_pay_type": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "worker_job_titles": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "operating_hours": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day_of_week": {
            "type": "integer"
          },
          "open_time": {
            "type": "string"
          },
          "close_time": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "open_time",
          "close_time"
        ]
      }
    },
    "utility_costs": {
      "type": "object",
      "properties": {
        "electricity": {
          "type": "number"
        },
        "water": {
          "type": "number"
        },
        "gas": {
          "type": "number"
        },
        "internet": {
          "type": "number"
        },
        "other": {
          "type": "number"
        }
      }
    },
    "rent_or_housing_cost": {
      "type": "number"
    },
    "bedroom_count": {
      "type": "integer",
      "default": 1
    },
    "gym_membership_fee": {
      "type": "number"
    },
    "gym_members": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "grocery_household_size": {
      "type": "integer"
    },
    "grocery_average_spend": {
      "type": "number"
    },
    "operating_cost": {
      "type": "number"
    },
    "cost_split_method": {
      "type": "string",
      "enum": [
        "even",
        "custom"
      ],
      "default": "even"
    },
    "resident_cost_split": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "income_generated": {
      "type": "number"
    },
    "last_income_updated": {
      "type": "string",
      "format": "date-time"
    },
    "is_default_generic": {
      "type": "boolean",
      "default": false
    },
    "generic_type": {
      "type": "string",
      "enum": [
        "park",
        "hospital",
        "grocery",
        "worship"
      ],
      "description": "Identifies which generic location type this is (if any). Remains constant even if user renames the location."
    },
    "generic_type_label": {
      "type": "string",
      "enum": [
        "park",
        "hospital",
        "grocery",
        "worship"
      ],
      "description": "Display label for the generic type (e.g., 'Generic Park', 'Generic Hospital')"
    }
  },
  "required": [
    "name",
    "location_type"
  ]
}