{
  "name": "CharacterCommitment",
  "type": "object",
  "properties": {
    "character_id": {
      "type": "string",
      "description": "Character making the commitment"
    },
    "character_name": {
      "type": "string",
      "description": "Display name of character"
    },
    "owner_email": {
      "type": "string",
      "description": "Owner email for RLS"
    },
    "commitment_type": {
      "type": "string",
      "enum": [
        "arrival",
        "meeting",
        "visit",
        "pickup"
      ],
      "description": "Type of commitment"
    },
    "destination_location_id": {
      "type": "string",
      "description": "Locked destination location ID"
    },
    "destination_location_name": {
      "type": "string",
      "description": "Locked destination location name"
    },
    "commitment_source": {
      "type": "string",
      "description": "Source: conversational_message, chat_commitment, etc."
    },
    "source_message_id": {
      "type": "string",
      "description": "ID of message that triggered commitment"
    },
    "source_conversation_id": {
      "type": "string",
      "description": "ID of conversation"
    },
    "commitment_text": {
      "type": "string",
      "description": "Original text: 'I'm on my way', 'I'll be there in 10 minutes', etc."
    },
    "expected_arrival_time": {
      "type": "string",
      "format": "date-time",
      "description": "When character committed to arrive"
    },
    "expected_arrival_window_minutes": {
      "type": "number",
      "default": 15,
      "description": "Believable arrival window in minutes"
    },
    "interruptible": {
      "type": "boolean",
      "default": false,
      "description": "Can this be overridden by autonomous logic? Only true for legitimate blockers (jail, health emergency, etc.)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "arrived",
        "cancelled",
        "blocked"
      ],
      "default": "active",
      "description": "Current commitment status"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When commitment was fulfilled"
    },
    "cancellation_reason": {
      "type": "string",
      "description": "Why commitment was cancelled/blocked"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "character_id",
    "owner_email",
    "commitment_type",
    "destination_location_id",
    "commitment_source"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "owner_email": "{{user.email}}"
    },
    "update": {
      "owner_email": "{{user.email}}"
    },
    "delete": {
      "owner_email": "{{user.email}}"
    }
  }
}