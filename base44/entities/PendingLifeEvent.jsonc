{
  "name": "PendingLifeEvent",
  "type": "object",
  "properties": {
    "character_id": {
      "type": "string",
      "description": "ID of the character this pending change belongs to"
    },
    "character_name": {
      "type": "string",
      "description": "Display name of the character"
    },
    "change_type": {
      "type": "string",
      "enum": [
        "occupation_change",
        "education_change",
        "job_training_change"
      ],
      "description": "What kind of change the AI is proposing"
    },
    "event_category": {
      "type": "string",
      "default": "life_change",
      "description": "Category for platform validation"
    },
    "description": {
      "type": "string",
      "description": "Description of the pending event (mirrors human_summary)"
    },
    "proposed_data": {
      "type": "object",
      "description": "The exact fields the AI wants to apply to the Character entity",
      "additionalProperties": true
    },
    "source_description": {
      "type": "string",
      "description": "The original event description that triggered this proposal"
    },
    "human_summary": {
      "type": "string",
      "description": "Plain-language description of the proposed change shown to the user"
    },
    "reasoning": {
      "type": "string",
      "description": "AI reasoning for why this change is proposed"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "linked"
      ],
      "default": "pending",
      "description": "Current approval status"
    },
    "linked_to_label": {
      "type": "string",
      "description": "If linked, the label of the existing entry it was linked to"
    }
  },
  "required": [
    "character_id",
    "change_type",
    "proposed_data",
    "description",
    "event_category"
  ]
}