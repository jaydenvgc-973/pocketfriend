{
  "name": "StoryEventImage",
  "type": "object",
  "properties": {
    "story_event_id": {
      "type": "string",
      "description": "ID of the parent StoryEvent"
    },
    "moment_type": {
      "type": "string",
      "enum": [
        "opening",
        "key_moment",
        "closing"
      ],
      "description": "Which moment in the story this image captures"
    },
    "image_url": {
      "type": "string",
      "description": "URL of the generated image"
    },
    "description": {
      "type": "string",
      "description": "What the image depicts"
    },
    "prompt": {
      "type": "string",
      "description": "The prompt used to generate this image"
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2,
      "description": "Display order (0=opening, 1=key, 2=closing)"
    },
    "visible_character_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of characters visible in this image"
    },
    "visible_character_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Display names of visible characters"
    },
    "visible_character_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "active_created_character",
          "npc_family_member",
          "npc_fictitious",
          "npc_world_service"
        ]
      },
      "description": "Character types of visible characters (same order as visible_character_ids)"
    },
    "reference_image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Character reference image URLs used during generation"
    },
    "reference_lookup_status_by_character": {
      "type": "object",
      "description": "Per-character lookup status: { character_id: 'resolved' | 'reference_lookup_failed' | 'character_not_found' }",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "resolved",
          "reference_lookup_failed",
          "character_not_found"
        ]
      }
    },
    "regeneration_reason": {
      "type": "string",
      "description": "Reason for last regeneration (if regenerated)"
    }
  },
  "required": [
    "story_event_id",
    "moment_type"
  ]
}