{
  "name": "HouseholdResource",
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "data.owner_email": "{{user.email}}"
    }
  },
  "properties": {
    "owner_email": {
      "type": "string",
      "description": "Email of the user who owns this household resource."
    },
    "home_location_id": {
      "type": "string",
      "description": "ID of the home LocationReference this resource belongs to."
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "food"
      ],
      "description": "Type of household resource. Currently only 'food' is supported."
    },
    "home_food_value": {
      "type": "number",
      "default": 0,
      "description": "Dollar-equivalent value of food available. Never goes negative."
    },
    "last_grocery_purchase_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_grocery_purchase_character_id": {
      "type": "string"
    },
    "last_grocery_purchase_character_name": {
      "type": "string"
    },
    "last_grocery_purchase_transaction_id": {
      "type": "string"
    },
    "grocery_source_location_id": {
      "type": "string"
    },
    "grocery_source_location_name": {
      "type": "string"
    },
    "last_consumed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "owner_email",
    "home_location_id",
    "resource_type"
  ]
}