{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "ID of the parent conversation"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "user",
        "character"
      ],
      "description": "Who sent this message"
    },
    "character_id": {
      "type": "string",
      "description": "ID of character if sender_type is character"
    },
    "character_name": {
      "type": "string",
      "description": "Display name of the character"
    },
    "sender_character_id": {
      "type": "string",
      "description": "For bilateral world phone: the character who authored this message"
    },
    "receiver_character_id": {
      "type": "string",
      "description": "For bilateral world phone: the character receiving this message"
    },
    "participant_character_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Sorted array of both participants in a bilateral conversation [A, B]"
    },
    "shared_conversation_key": {
      "type": "string",
      "description": "Deterministic key for bilateral conversations (bilateral_sortedIds_channel)"
    },
    "played_as_character_id": {
      "type": "string",
      "description": "If the user sent this while playing as a character, the ID of that character"
    },
    "played_as_character_name": {
      "type": "string",
      "description": "If the user sent this while playing as a character, the display name of that character"
    },
    "content": {
      "type": "string",
      "description": "Message text content"
    },
    "image_url": {
      "type": "string",
      "description": "Optional image URL attached to the message"
    },
    "image_description": {
      "type": "string",
      "description": "Vision-analyzed description of the attached image. Stored durably. Injected into character prompt context."
    },
    "image_analysis_status": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "failed"
      ],
      "description": "Status of the image visual analysis pipeline"
    },
    "image_analysis_error": {
      "type": "string",
      "description": "Error message if image analysis failed"
    },
    "audio_url": {
      "type": "string",
      "description": "Base64 or URL of generated voice audio for this message"
    },
    "emotional_state": {
      "type": "string",
      "enum": [
        "calm",
        "irritated",
        "defensive",
        "reflective",
        "closed-off"
      ],
      "description": "Character emotional state when sending"
    },
    "is_narrative": {
      "type": "boolean",
      "description": "True if this message represents a narrative event"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has read this message"
    },
    "archived_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this message was archived from active chat view (not deleted)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "reactions": {
      "type": "array",
      "description": "Emoji reactions to this message",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "emoji": {
            "type": "string"
          },
          "reactor_type": {
            "type": "string",
            "enum": [
              "user",
              "character"
            ]
          },
          "reactor_id": {
            "type": "string"
          }
        }
      }
    },
    "generation_context": {
      "type": "object",
      "description": "Stored generation metadata for image messages \u2014 used to power accurate regeneration. additionalProperties MUST remain true. Removing it silently strips all structured subject bundle fields (subjects, image_type, resolved_outfit_metadata etc.) on every DB write, causing regeneration to silently fall back to legacy single-subject behavior. This is a HARD SYSTEM REQUIREMENT.",
      "additionalProperties": true,
      "properties": {
        "generation_context_version": {
          "type": "number",
          "description": "Schema version. 2 = modern sealed subject bundle format. Absence = legacy flat-only context."
        },
        "context_origin": {
          "type": "string",
          "description": "Which generation pathway created this context: chat_image | media_grid | regenerate | recovery"
        },
        "schema_written_at": {
          "type": "string",
          "description": "ISO timestamp when this generation_context was written. Used to detect stale or pre-fix contexts."
        },
        "prompt": {
          "type": "string",
          "description": "The original user-facing scene prompt (without system instructions)"
        },
        "character_id": {
          "type": "string"
        },
        "character_reference_images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "location_id": {
          "type": "string"
        },
        "zone_name": {
          "type": "string"
        },
        "location_name": {
          "type": "string"
        },
        "location_reference_images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subject_type": {
          "type": "string",
          "description": "character | user | joint | multi"
        },
        "image_type": {
          "type": "string",
          "description": "character | user | joint | multi"
        },
        "subject_count": {
          "type": "number"
        },
        "subjects": {
          "type": "array",
          "description": "Structured per-subject identity data for multi-person and joint images. MUST persist with additionalProperties:true on items.",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "subject_type": {
                "type": "string"
              },
              "subject_id": {
                "type": "string"
              },
              "subject_name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "reference_image_count": {
                "type": "number"
              },
              "reference_images": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "subject_fingerprint": {
                "type": "string",
                "description": "Identity checksum: stable_id:ref_count. Used by regen/video systems to detect missing or swapped subject bundles."
              },
              "appearance_lock_snapshot": {
                "type": "object",
                "additionalProperties": true
              },
              "outfit_snapshot": {
                "type": "string"
              },
              "appearance_lock_injected": {
                "type": "boolean"
              },
              "outfit_injected": {
                "type": "boolean"
              }
            }
          }
        },
        "scene_prompt": {
          "type": "string"
        },
        "original_raw_prompt": {
          "type": "string"
        },
        "resolved_outfit_metadata": {
          "type": "array",
          "description": "Per-subject outfit metadata used at generation time. Each entry: { subjectType, name, text, source }",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "subjectType": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            }
          }
        },
        "user_outfit_text": {
          "type": "string"
        },
        "user_outfit_source": {
          "type": "string"
        },
        "camera_variables": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "distance": {
              "type": "string"
            },
            "angle": {
              "type": "string"
            },
            "height": {
              "type": "string"
            },
            "framing": {
              "type": "string"
            },
            "lens_style": {
              "type": "string"
            }
          }
        },
        "attempts": {
          "type": "array",
          "description": "All generation attempts (accepted and rejected) for audit and camera enforcement.",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "attempt_index": {
                "type": "number"
              },
              "prompt": {
                "type": "string"
              },
              "generated_image_url": {
                "type": "string"
              },
              "camera": {
                "type": "object",
                "additionalProperties": true
              },
              "status": {
                "type": "string"
              },
              "rejection_reason": {
                "type": "string"
              },
              "created_at": {
                "type": "string"
              }
            }
          }
        },
        "accepted_attempt_index": {
          "type": "number"
        },
        "subjectType": {
          "type": "string"
        },
        "selectedPeople": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "characterReferenceImages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locationName": {
          "type": "string"
        },
        "zoneName": {
          "type": "string"
        },
        "locationReferenceImages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generatedAt": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "user_reference_images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "background_extras_allowed": {
          "type": "boolean"
        },
        "appearance_lock_corrections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "location_share": {
      "type": "object",
      "description": "Character location share card \u2014 populated when character shares their real verified location",
      "properties": {
        "location_id": {
          "type": "string",
          "description": "ID of the LocationReference record"
        },
        "location_name": {
          "type": "string",
          "description": "Display name of the location"
        },
        "presence_status": {
          "type": "string",
          "description": "Character's presence status at this location"
        },
        "location_category": {
          "type": "string",
          "description": "Category of the location"
        },
        "character_avatar_url": {
          "type": "string",
          "description": "Character avatar URL for display in the card"
        },
        "note": {
          "type": "string",
          "description": "Optional note from the character about why they're sharing"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the location was shared"
        }
      }
    },
    "money_transfer": {
      "type": "object",
      "description": "Money transfer card \u2014 populated when user sends money to a character or vice versa",
      "properties": {
        "amount": {
          "type": "number",
          "description": "Amount transferred in USD"
        },
        "direction": {
          "type": "string",
          "enum": [
            "sent",
            "received"
          ],
          "description": "Direction from the user's perspective"
        },
        "recipient_name": {
          "type": "string",
          "description": "Display name of who received the money"
        },
        "recipient_id": {
          "type": "string",
          "description": "Character ID of recipient"
        },
        "sender_name": {
          "type": "string",
          "description": "Display name of who sent the money"
        },
        "reason": {
          "type": "string",
          "description": "Optional reason for the transfer"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "songs_heard": {
      "type": "array",
      "description": "Songs shared or referenced in this message",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "spotify_id": {
            "type": "string"
          },
          "lyrics_excerpt": {
            "type": "string"
          },
          "full_lyrics": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "link": {
            "type": "string"
          },
          "preview_url": {
            "type": "string"
          },
          "added_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "videos_watched": {
      "type": "array",
      "description": "Videos shared or referenced in this message",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "creator": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "duration": {
            "type": "string"
          },
          "link": {
            "type": "string"
          },
          "added_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "typed_by_user": {
      "type": "boolean",
      "default": false,
      "description": "True if user typed this message (not generated by system)"
    },
    "user_operated": {
      "type": "boolean",
      "default": false,
      "description": "True if user directly caused this message via world phone or similar"
    },
    "channel": {
      "type": "string",
      "description": "Communication channel: world_phone, direct_text, scene, etc."
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "failed"
      ],
      "description": "Bilateral sync status for world phone messages"
    },
    "sync_error": {
      "type": "string",
      "description": "Error message if bilateral sync failed"
    },
    "source_message_id": {
      "type": "string",
      "description": "ID of the user message this character response was generated from. Used for idempotency and linking replies to sources."
    },
    "reply_to_message_id": {
      "type": "string",
      "description": "ID of the message this is replying to (may be same as source_message_id or a previous character message)."
    },
    "idempotency_key": {
      "type": "string",
      "description": "Unique key for idempotent saves across retries, recoveries, and proactive sends. Format depends on path: proactive::email::charId::channel::timebucket OR group_chat::charId::convoId::sourceMessageId OR recovery::email::charId::channel::sourceMessageId::stage"
    },
    "generation_lock_id": {
      "type": "string",
      "description": "ID of the generation lock that guarded this message's creation (Chat/Text/World Phone paths). Null for Group Chat and Proactive."
    },
    "recovery_signal": {
      "type": "boolean",
      "default": false,
      "description": "True if this message is a technical failure signal or transient recovery placeholder. False for real character dialogue. CRITICAL: recovery_signal=true messages must NEVER trigger memory or relationship updates."
    },
    "memory_eligible": {
      "type": "boolean",
      "default": true,
      "description": "True if this message can be read by memory extraction and relationship pipelines. False for fallback signals or messages that failed eligibility checks. Controls whether syncGroupChatMemories and related functions process this message."
    },
    "relationship_eligible": {
      "type": "boolean",
      "default": true,
      "description": "True if this message can trigger relationship level updates and progression changes. False for fallback signals or transient recovery messages. Controls whether relationship sync reads this message."
    }
  },
  "required": [
    "conversation_id",
    "sender_type",
    "content"
  ]
}