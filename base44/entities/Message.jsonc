{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "ID of the parent conversation"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "user",
        "character"
      ],
      "description": "Who sent this message"
    },
    "character_id": {
      "type": "string",
      "description": "ID of character if sender_type is character"
    },
    "character_name": {
      "type": "string",
      "description": "Display name of the character"
    },
    "played_as_character_id": {
      "type": "string",
      "description": "If the user sent this while playing as a character, the ID of that character"
    },
    "played_as_character_name": {
      "type": "string",
      "description": "If the user sent this while playing as a character, the display name of that character"
    },
    "content": {
      "type": "string",
      "description": "Message text content"
    },
    "image_url": {
      "type": "string",
      "description": "Optional image URL attached to the message"
    },
    "audio_url": {
      "type": "string",
      "description": "Base64 or URL of generated voice audio for this message"
    },
    "emotional_state": {
      "type": "string",
      "enum": [
        "calm",
        "irritated",
        "defensive",
        "reflective",
        "closed-off"
      ],
      "description": "Character emotional state when sending"
    },
    "is_narrative": {
      "type": "boolean",
      "description": "True if this message represents a narrative event"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has read this message"
    },
    "archived_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this message was archived from active chat view (not deleted)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "reactions": {
      "type": "array",
      "description": "Emoji reactions to this message",
      "items": {
        "type": "object",
        "properties": {
          "emoji": {
            "type": "string"
          },
          "reactor_type": {
            "type": "string",
            "enum": [
              "user",
              "character"
            ]
          },
          "reactor_id": {
            "type": "string"
          }
        }
      }
    },
    "generation_context": {
      "type": "object",
      "description": "Stored generation metadata for image messages \u2014 used to power accurate regeneration",
      "properties": {
        "prompt": {
          "type": "string",
          "description": "The original user-facing scene prompt (without system instructions)"
        },
        "character_id": {
          "type": "string"
        },
        "character_reference_images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "location_id": {
          "type": "string"
        },
        "zone_name": {
          "type": "string"
        },
        "location_name": {
          "type": "string"
        },
        "location_reference_images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subject_type": {
          "type": "string",
          "description": "character | user | joint"
        }
      }
    },
    "songs_heard": {
      "type": "array",
      "description": "Songs shared or referenced in this message",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "spotify_id": {
            "type": "string"
          },
          "lyrics_excerpt": {
            "type": "string"
          },
          "full_lyrics": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "link": {
            "type": "string"
          },
          "preview_url": {
            "type": "string"
          },
          "added_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "videos_watched": {
      "type": "array",
      "description": "Videos shared or referenced in this message",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "creator": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "duration": {
            "type": "string"
          },
          "link": {
            "type": "string"
          },
          "added_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "required": [
    "conversation_id",
    "sender_type",
    "content"
  ]
}