{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "ID of the parent conversation"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "user",
        "character"
      ],
      "description": "Who sent this message"
    },
    "character_id": {
      "type": "string",
      "description": "ID of character if sender_type is character"
    },
    "character_name": {
      "type": "string",
      "description": "Display name of the character"
    },
    "sender_character_id": {
      "type": "string",
      "description": "For bilateral world phone: the character who authored this message"
    },
    "receiver_character_id": {
      "type": "string",
      "description": "For bilateral world phone: the character receiving this message"
    },
    "participant_character_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Sorted array of both participants in a bilateral conversation [A, B]"
    },
    "shared_conversation_key": {
      "type": "string",
      "description": "Deterministic key for bilateral conversations (bilateral_sortedIds_channel)"
    },
    "played_as_character_id": {
      "type": "string",
      "description": "If the user sent this while playing as a character, the ID of that character"
    },
    "played_as_character_name": {
      "type": "string",
      "description": "If the user sent this while playing as a character, the display name of that character"
    },
    "content": {
      "type": "string",
      "description": "Message text content"
    },
    "image_url": {
      "type": "string",
      "description": "Optional image URL attached to the message"
    },
    "image_description": {
      "type": "string",
      "description": "Vision-analyzed description of the attached image. Stored durably. Injected into character prompt context."
    },
    "inferred_image_description": {
      "type": "string",
      "description": "Image description inferred from post-send visual analysis (promptless gallery sends). Separate from original image_description."
    },
    "visual_analysis_description": {
      "type": "string",
      "description": "Rich visual analysis description from detailed analysis pipeline."
    },
    "user_edited_description": {
      "type": "string",
      "description": "User-manually-edited image description. Locked from auto-overwrite. Takes priority over all auto-generated descriptions."
    },
    "description_last_edited_by_user": {
      "type": "boolean",
      "default": false,
      "description": "True if user has manually edited the image description."
    },
    "description_edit_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the user last edited the image description."
    },
    "description_source": {
      "type": "string",
      "enum": [
        "user_edited",
        "visual_analysis",
        "inferred_analysis",
        "image_description",
        "original_prompt",
        "manual_generation",
        "none"
      ],
      "description": "Source of the currently active image description."
    },
    "image_analysis_status": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "failed",
        "manual"
      ],
      "description": "Status of the image visual analysis pipeline"
    },
    "image_analysis_error": {
      "type": "string",
      "description": "Error message if image analysis failed"
    },
    "image_analysis_is_transport_metadata": {
      "type": "boolean",
      "default": false,
      "description": "True if the stored description is transport metadata (routing label), not visual content."
    },
    "image_analysis_source": {
      "type": "string",
      "description": "Source label for image analysis (e.g., 'media_gallery_send_visual_analysis', 'user_manual_media_gallery_description')."
    },
    "image_analysis_is_inferred": {
      "type": "boolean",
      "default": false,
      "description": "True if description came from inferred/post-send analysis, not original generation context."
    },
    "audio_url": {
      "type": "string",
      "description": "Base64 or URL of generated voice audio for this message"
    },
    "emotional_state": {
      "type": "string",
      "enum": [
        "calm",
        "irritated",
        "defensive",
        "reflective",
        "closed-off"
      ],
      "description": "Character emotional state when sending"
    },
    "is_narrative": {
      "type": "boolean",
      "description": "True if this message represents a narrative event"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has read this message"
    },
    "archived_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this message was archived from active chat view (not deleted)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "reactions": {
      "type": "array",
      "description": "Emoji reactions to this message",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "emoji": {
            "type": "string"
          },
          "reactor_type": {
            "type": "string",
            "enum": [
              "user",
              "character"
            ]
          },
          "reactor_id": {
            "type": "string"
          }
        }
      }
    },
    "generation_context": {
      "type": "object",
      "description": "Stored generation metadata for image messages \u2014 used to power accurate regeneration. additionalProperties MUST remain true.",
      "additionalProperties": true,
      "properties": {
        "generation_context_version": {
          "type": "number"
        },
        "context_origin": {
          "type": "string"
        },
        "schema_written_at": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "character_id": {
          "type": "string"
        },
        "character_reference_images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "location_id": {
          "type": "string"
        },
        "zone_name": {
          "type": "string"
        },
        "location_name": {
          "type": "string"
        },
        "location_reference_images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subject_type": {
          "type": "string"
        },
        "image_type": {
          "type": "string"
        },
        "subject_count": {
          "type": "number"
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "subject_type": {
                "type": "string"
              },
              "subject_id": {
                "type": "string"
              },
              "subject_name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "reference_image_count": {
                "type": "number"
              },
              "reference_images": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "subject_fingerprint": {
                "type": "string"
              },
              "appearance_lock_snapshot": {
                "type": "object",
                "additionalProperties": true
              },
              "outfit_snapshot": {
                "type": "string"
              },
              "appearance_lock_injected": {
                "type": "boolean"
              },
              "outfit_injected": {
                "type": "boolean"
              }
            }
          }
        },
        "scene_prompt": {
          "type": "string"
        },
        "original_raw_prompt": {
          "type": "string"
        },
        "resolved_outfit_metadata": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "subjectType": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            }
          }
        },
        "user_outfit_text": {
          "type": "string"
        },
        "user_outfit_source": {
          "type": "string"
        },
        "camera_variables": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "distance": {
              "type": "string"
            },
            "angle": {
              "type": "string"
            },
            "height": {
              "type": "string"
            },
            "framing": {
              "type": "string"
            },
            "lens_style": {
              "type": "string"
            }
          }
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "attempt_index": {
                "type": "number"
              },
              "prompt": {
                "type": "string"
              },
              "generated_image_url": {
                "type": "string"
              },
              "camera": {
                "type": "object",
                "additionalProperties": true
              },
              "status": {
                "type": "string"
              },
              "rejection_reason": {
                "type": "string"
              },
              "created_at": {
                "type": "string"
              }
            }
          }
        },
        "accepted_attempt_index": {
          "type": "number"
        },
        "subjectType": {
          "type": "string"
        },
        "selectedPeople": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "characterReferenceImages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locationName": {
          "type": "string"
        },
        "zoneName": {
          "type": "string"
        },
        "locationReferenceImages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generatedAt": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "user_reference_images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "background_extras_allowed": {
          "type": "boolean"
        },
        "appearance_lock_corrections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "location_share": {
      "type": "object",
      "description": "Character location share card \u2014 populated when character shares their real verified location",
      "properties": {
        "location_id": {
          "type": "string"
        },
        "location_name": {
          "type": "string"
        },
        "presence_status": {
          "type": "string"
        },
        "location_category": {
          "type": "string"
        },
        "character_avatar_url": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "money_transfer": {
      "type": "object",
      "description": "Money transfer card \u2014 populated when user sends money to a character or vice versa",
      "properties": {
        "amount": {
          "type": "number"
        },
        "direction": {
          "type": "string",
          "enum": [
            "sent",
            "received"
          ]
        },
        "recipient_name": {
          "type": "string"
        },
        "recipient_id": {
          "type": "string"
        },
        "sender_name": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "songs_heard": {
      "type": "array",
      "description": "Songs shared or referenced in this message",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "spotify_id": {
            "type": "string"
          },
          "lyrics_excerpt": {
            "type": "string"
          },
          "full_lyrics": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "link": {
            "type": "string"
          },
          "preview_url": {
            "type": "string"
          },
          "added_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "videos_watched": {
      "type": "array",
      "description": "Videos shared or referenced in this message",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "creator": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "duration": {
            "type": "string"
          },
          "link": {
            "type": "string"
          },
          "added_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "typed_by_user": {
      "type": "boolean",
      "default": false,
      "description": "True if user typed this message (not generated by system)"
    },
    "user_operated": {
      "type": "boolean",
      "default": false,
      "description": "True if user directly caused this message via world phone or similar"
    },
    "channel": {
      "type": "string",
      "description": "Communication channel: world_phone, direct_text, scene, etc."
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "failed"
      ],
      "description": "Bilateral sync status for world phone messages"
    },
    "sync_error": {
      "type": "string",
      "description": "Error message if bilateral sync failed"
    },
    "is_forwarded": {
      "type": "boolean",
      "default": false,
      "description": "True if this message was forwarded from another conversation"
    },
    "forwarded_from": {
      "type": "string",
      "description": "Character or user name this message was forwarded from"
    },
    "source_message_id": {
      "type": "string",
      "description": "ID of the user message that triggered this character response. Used as the idempotency anchor to prevent duplicate character replies."
    },
    "reply_to_message_id": {
      "type": "string",
      "description": "ID of the message this is a direct reply to (same as source_message_id for text responses)."
    },
    "idempotency_key": {
      "type": "string",
      "description": "Composite idempotency key that uniquely identifies this message generation attempt."
    },
    "generation_lock_id": {
      "type": "string",
      "description": "ID of the generation lock that was held during this message's creation."
    },
    "recovery_signal": {
      "type": "boolean",
      "default": false,
      "description": "CRITICAL CLASSIFICATION FIELD. false = real character dialogue. true = technical failure state signal (never memory-eligible, never relationship-eligible)."
    },
    "memory_eligible": {
      "type": "boolean",
      "default": true,
      "description": "When true, this message may be read by memory extraction pipelines. When false, excluded from all memory writes."
    },
    "relationship_eligible": {
      "type": "boolean",
      "default": true,
      "description": "When true, this message may trigger relationship score updates. When false, excluded from all relationship progression."
    },
    "source_media_message_id": {
      "type": "string",
      "description": "ID of original Media Gallery message if this image was sent from gallery."
    },
    "source_media_url": {
      "type": "string",
      "description": "Original image URL if sent from Media Gallery."
    },
    "source_media_had_prompt": {
      "type": "boolean",
      "default": false,
      "description": "True if the original gallery image had a generation prompt/context."
    },
    "source_media_had_generation_context": {
      "type": "boolean",
      "default": false,
      "description": "True if the original gallery image had generation context metadata."
    },
    "canon_excluded": {
      "type": "boolean",
      "default": false,
      "description": "True when this message has been removed from canon by the user. It must not influence memories, relationship progression, journal entries, summaries, or future context assembly. Treated as if it never existed."
    },
    "canon_exclusion_reason": {
      "type": "string",
      "description": "Why this message was excluded from canon: user_removal, fourth_wall, impossible_knowledge, canon_violation."
    },
    "canon_excluded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the canon exclusion was applied."
    },
    "autonomy_marker": {
      "type": "string",
      "description": "Marker for autonomously generated messages, for analytics and filtering."
    }
  },
  "required": [
    "conversation_id",
    "sender_type",
    "content"
  ]
}