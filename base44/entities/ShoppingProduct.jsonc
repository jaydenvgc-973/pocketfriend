{
  "name": "ShoppingProduct",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "clothes",
        "sneakers",
        "accessories"
      ],
      "description": "Product category"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "hoodie",
        "jacket",
        "shirt",
        "pants",
        "sneakers",
        "shoes",
        "hat",
        "bag",
        "watch",
        "jewelry",
        "eyewear"
      ],
      "description": "Specific item type"
    },
    "name": {
      "type": "string",
      "description": "Product name"
    },
    "description": {
      "type": "string",
      "description": "Product description"
    },
    "brand": {
      "type": "string",
      "description": "Brand name (optional)"
    },
    "color": {
      "type": "string",
      "description": "Product color"
    },
    "size_options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Available sizes",
      "default": []
    },
    "price": {
      "type": "number",
      "description": "Price in USD",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "image_url": {
      "type": "string",
      "description": "AI-generated product image URL"
    },
    "image_status": {
      "type": "string",
      "enum": [
        "not_generated",
        "generated",
        "failed"
      ],
      "default": "not_generated",
      "description": "Image generation status"
    },
    "image_generation_prompt": {
      "type": "string",
      "description": "Prompt used to generate the image"
    },
    "image_generation_style": {
      "type": "string",
      "enum": [
        "product_clean",
        "hanger_display",
        "mannequin_display",
        "shoe_product_shot",
        "accessory_product_shot"
      ],
      "description": "Style used for image generation"
    },
    "visual_identity_seed": {
      "type": "string",
      "description": "Seed to keep visual consistency across regenerations"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "unavailable",
        "archived"
      ],
      "default": "available"
    }
  },
  "required": [
    "category",
    "item_type",
    "name",
    "price"
  ]
}