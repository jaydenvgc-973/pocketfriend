{
  "name": "ScheduleLoopLease",
  "type": "object",
  "description": "The recurring schedule's own next established boundary, plus the last completed occurrence already delivered to the automatic narrative pathway. A run that wakes on a boundary writes the following boundary here, which hands it to the next durable run \u2014 the schedule carries its own recurrence. Written only by the schedule enforcement backend functions.",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "character_id": {
      "type": "string",
      "description": "Character whose recurring schedule this record belongs to"
    },
    "owner_email": {
      "type": "string",
      "description": "Owner of the character, for auditing"
    },
    "schedule_kind": {
      "type": "string",
      "enum": [
        "work",
        "school"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "description": "Which recurring schedule this record belongs to"
    },
    "next_boundary_at": {
      "type": "string",
      "format": "date-time",
      "description": "The next established boundary of this schedule, normalized to the minute. Each write hands that boundary to the next durable run; the same boundary is never written twice, so the chain advances exactly one occurrence at a time."
    },
    "last_completion_occurrence": {
      "type": "string",
      "description": "Identity of the last completed occurrence delivered to the narrative pathway (event type + Eastern day + end time). A repeat delivery of that same occurrence is skipped; a different occurrence always proceeds."
    }
  },
  "required": [
    "character_id",
    "schedule_kind"
  ]
}