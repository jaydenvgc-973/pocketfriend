{
  "name": "CharacterFinancial",
  "type": "object",
  "properties": {
    "character_id": {
      "type": "string",
      "description": "ID of the character this financial record belongs to"
    },
    "character_name": {
      "type": "string",
      "description": "Display name of the character"
    },
    "is_npc": {
      "type": "boolean",
      "default": false,
      "description": "True if this is an NPC record (affects payment rules)"
    },
    "home_location_id": {
      "type": "string",
      "description": "ID of the character's home location"
    },
    "home_location_name": {
      "type": "string",
      "description": "Display name of the home location"
    },
    "is_homeless": {
      "type": "boolean",
      "default": false,
      "description": "True if character has no permanent home"
    },
    "work_location_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of work locations (primary and secondary jobs)"
    },
    "work_location_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Display names of work locations"
    },
    "hourly_rates": {
      "type": "object",
      "description": "Hourly pay rate by location_id (e.g. { 'loc_123': 15.00 })",
      "additionalProperties": {
        "type": "number"
      }
    },
    "annual_salaries": {
      "type": "object",
      "description": "Annual salary by location_id (e.g. { 'loc_123': 52000 })",
      "additionalProperties": {
        "type": "number"
      }
    },
    "current_balance": {
      "type": "number",
      "default": 6000,
      "description": "Current money balance (USD). Defaults to $6,000 for new characters."
    },
    "total_income": {
      "type": "number",
      "default": 0,
      "description": "Cumulative total income earned (USD)"
    },
    "total_expenses": {
      "type": "number",
      "default": 0,
      "description": "Cumulative total expenses paid (USD)"
    },
    "income_sources": {
      "type": "array",
      "description": "Breakdown of income by location",
      "items": {
        "type": "object",
        "properties": {
          "location_id": {
            "type": "string"
          },
          "location_name": {
            "type": "string"
          },
          "pay_type": {
            "type": "string",
            "enum": [
              "hourly",
              "annual"
            ]
          },
          "pay_amount": {
            "type": "number"
          },
          "total_earned": {
            "type": "number"
          },
          "last_payment_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "recurring_expenses": {
      "type": "array",
      "description": "All location-tied recurring expenses (rent, utilities, gym, etc.)",
      "items": {
        "type": "object",
        "properties": {
          "expense_type": {
            "type": "string",
            "enum": [
              "rent",
              "utilities",
              "groceries",
              "gym",
              "childcare",
              "custom"
            ]
          },
          "location_id": {
            "type": "string",
            "description": "Location ID if tied to a place (rent, utilities, gym, childcare)"
          },
          "location_name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "description": "Free-text description for custom expenses"
          },
          "monthly_cost": {
            "type": "number"
          },
          "total_paid": {
            "type": "number",
            "default": 0
          },
          "last_payment_date": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "expense_type",
          "monthly_cost"
        ]
      }
    },
    "other_monthly_expenses": {
      "type": "array",
      "description": "Personal monthly expenses not tied to a location (phone, internet, car, child support, etc.)",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Expense name (e.g. 'Cell Phone', 'Car Payment', 'Child Support')"
          },
          "amount": {
            "type": "number",
            "description": "Monthly cost in USD"
          },
          "type": {
            "type": "string",
            "enum": [
              "cell_phone",
              "internet",
              "automotive",
              "insurance",
              "child_support",
              "subscription",
              "custom"
            ],
            "description": "Expense category"
          },
          "total_paid": {
            "type": "number",
            "default": 0,
            "description": "Cumulative amount paid for this expense"
          },
          "last_payment_date": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "name",
          "amount",
          "type"
        ]
      },
      "default": []
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Last time financial data was recalculated"
    }
  },
  "required": [
    "character_id",
    "character_name"
  ]
}