{
  "name": "CommunityEvent",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Event name (e.g., 'Open Mic Night', 'Community Cookout')"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "social",
        "cultural",
        "fitness",
        "educational",
        "support",
        "celebration",
        "health_awareness",
        "resource_fair",
        "entertainment",
        "personal",
        "other"
      ],
      "default": "social",
      "description": "Category of event"
    },
    "source": {
      "type": "string",
      "enum": [
        "system",
        "community",
        "user_calendar",
        "user"
      ],
      "default": "community",
      "description": "Where this event originated. user_calendar = created by user from Moments calendar."
    },
    "show_on_community_strip": {
      "type": "boolean",
      "default": true,
      "description": "When source=user_calendar, controls whether this event appears on the Homepage Community Activity strip."
    },
    "location_id": {
      "type": "string",
      "description": "ID of the location where event is held (optional for user-created calendar events)"
    },
    "location_name": {
      "type": "string",
      "description": "Display name of location"
    },
    "start_date": {
      "type": "string",
      "format": "date-time",
      "description": "When event starts"
    },
    "end_date": {
      "type": "string",
      "format": "date-time",
      "description": "When event ends (optional)"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false,
      "description": "True if this is a recurring event (weekly, monthly, etc.)"
    },
    "recurrence_pattern": {
      "type": "string",
      "enum": [
        "weekly",
        "biweekly",
        "monthly",
        "none"
      ],
      "default": "none",
      "description": "How often it recurs"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this event is currently active/visible"
    },
    "description": {
      "type": "string",
      "description": "Short description of the event"
    },
    "expected_attendee_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Types of people who typically attend"
    },
    "vibe": {
      "type": "string",
      "enum": [
        "quiet",
        "social",
        "energetic",
        "mixed"
      ],
      "default": "social",
      "description": "General atmosphere/energy level"
    },
    "owner_email": {
      "type": "string",
      "description": "User account that created/manages this event. Required for user_calendar events."
    },
    "participations_count": {
      "type": "integer",
      "default": 0,
      "description": "Cached count of characters who attended"
    },
    "last_occurrence_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this event last occurred (for recurring events)"
    }
  },
  "required": [
    "name",
    "start_date"
  ]
}