{
  "name": "UserSettings",
  "type": "object",
  "properties": {
    "has_completed_onboarding": {
      "type": "boolean",
      "default": false
    },
    "default_character_id": {
      "type": "string"
    },
    "response_length": {
      "type": "string",
      "enum": [
        "short",
        "medium",
        "long"
      ],
      "default": "medium"
    },
    "emotional_intensity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "voice_enabled": {
      "type": "boolean",
      "default": false
    },
    "openai_api_key": {
      "type": "string",
      "description": "User's OpenAI API key for voice generation"
    },
    "voice_minutes_used": {
      "type": "number",
      "default": 0,
      "description": "Approximate minutes of voice generation used"
    },
    "user_birthday": {
      "type": "string",
      "format": "date",
      "description": "User's birthday (YYYY-MM-DD)"
    },
    "user_gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "non-binary",
        "other"
      ],
      "description": "User's gender"
    },
    "fictional_world_name": {
      "type": "string",
      "description": "The name the user goes by in the fictional world."
    },
    "user_aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Alternate names, nicknames, and aliases for the user."
    },
    "response_lag_enabled": {
      "type": "boolean",
      "default": true
    },
    "typing_speed_enabled": {
      "type": "boolean",
      "default": true
    },
    "words_per_minute": {
      "type": "number",
      "default": 41
    },
    "user_schedule_notes": {
      "type": "string"
    },
    "user_balance": {
      "type": "number",
      "default": 6000,
      "description": "User's in-world financial balance (USD)."
    },
    "vgc_mobile_revenue": {
      "type": "number",
      "default": 0,
      "description": "Total revenue earned from character VGC Mobile phone bills (USD)."
    },
    "user_relatives": {
      "type": "object",
      "description": "Map of character IDs to their relationship to the user",
      "additionalProperties": {
        "type": "string"
      }
    },
    "last_daily_income_date": {
      "type": "string"
    },
    "appearance_lock": {
      "type": "object",
      "description": "Locked appearance attributes for the user.",
      "properties": {
        "skin_tone": {
          "type": "string"
        },
        "hair_type": {
          "type": "string"
        },
        "hairstyle": {
          "type": "string"
        },
        "facial_hair": {
          "type": "string"
        },
        "makeup": {
          "type": "string"
        },
        "clothing_style": {
          "type": "string"
        },
        "footwear": {
          "type": "string"
        },
        "overall_aesthetic": {
          "type": "string"
        },
        "custom_keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "home_key_holders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "character_id": {
            "type": "string"
          },
          "character_name": {
            "type": "string"
          },
          "location_id": {
            "type": "string"
          },
          "location_name": {
            "type": "string"
          },
          "granted_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": [],
      "description": "Characters who have given the user a key to their home, allowing entry even when they are away."
    }
  },
  "required": []
}