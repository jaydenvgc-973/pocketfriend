{
  "name": "UserSettings",
  "type": "object",
  "properties": {
    "has_completed_onboarding": {
      "type": "boolean",
      "default": false
    },
    "default_character_id": {
      "type": "string"
    },
    "response_length": {
      "type": "string",
      "enum": [
        "short",
        "medium",
        "long"
      ],
      "default": "medium"
    },
    "emotional_intensity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "voice_enabled": {
      "type": "boolean",
      "default": false
    },
    "openai_api_key": {
      "type": "string",
      "description": "User's OpenAI API key for voice generation"
    },
    "voice_minutes_used": {
      "type": "number",
      "default": 0,
      "description": "Approximate minutes of voice generation used"
    },
    "user_birthday": {
      "type": "string",
      "format": "date",
      "description": "User's birthday (YYYY-MM-DD)"
    },
    "user_gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "non-binary",
        "other"
      ],
      "description": "User's gender"
    },
    "fictional_world_name": {
      "type": "string",
      "description": "The name the user goes by in the fictional world."
    },
    "user_aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Alternate names, nicknames, and aliases for the user."
    },
    "response_lag_enabled": {
      "type": "boolean",
      "default": true
    },
    "typing_speed_enabled": {
      "type": "boolean",
      "default": true
    },
    "words_per_minute": {
      "type": "number",
      "default": 41
    },
    "user_schedule_notes": {
      "type": "string"
    },
    "user_balance": {
      "type": "number",
      "default": 6000,
      "description": "User's in-world financial balance (USD)."
    },
    "vgc_mobile_revenue": {
      "type": "number",
      "default": 0,
      "description": "Total revenue earned from character VGC Mobile phone bills (USD)."
    },
    "user_relatives": {
      "type": "object",
      "description": "Map of character IDs to their relationship to the user",
      "additionalProperties": {
        "type": "string"
      }
    },
    "last_daily_income_date": {
      "type": "string"
    },
    "appearance_lock": {
      "type": "object",
      "description": "Locked appearance attributes for the user.",
      "properties": {
        "skin_tone": {
          "type": "string"
        },
        "hair_type": {
          "type": "string"
        },
        "hairstyle": {
          "type": "string"
        },
        "facial_hair": {
          "type": "string"
        },
        "makeup": {
          "type": "string"
        },
        "clothing_style": {
          "type": "string"
        },
        "footwear": {
          "type": "string"
        },
        "overall_aesthetic": {
          "type": "string"
        },
        "custom_keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "height_inches": {
          "type": "number"
        },
        "height_display": {
          "type": "string"
        },
        "head_ratio": {
          "type": "number"
        }
      }
    },
    "home_key_holders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "character_id": {
            "type": "string"
          },
          "character_name": {
            "type": "string"
          },
          "location_id": {
            "type": "string"
          },
          "location_name": {
            "type": "string"
          },
          "granted_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": [],
      "description": "Characters who have given the user a key to their home, allowing entry even when they are away."
    },
    "user_closet": {
      "type": "array",
      "description": "User's saved outfits for image generation.",
      "items": {
        "type": "object",
        "properties": {
          "outfit_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "daily_casual",
              "work",
              "gym",
              "church",
              "nightlife",
              "formal",
              "sleepwear",
              "lounge",
              "outdoor",
              "special"
            ],
            "default": "daily_casual"
          },
          "top": {
            "type": "string"
          },
          "bottom": {
            "type": "string"
          },
          "shoes": {
            "type": "string"
          },
          "outerwear": {
            "type": "string"
          },
          "accessories": {
            "type": "string"
          },
          "hair_state": {
            "type": "string"
          },
          "full_description": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          },
          "is_favorite": {
            "type": "boolean",
            "default": false
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "outfit_id",
          "label"
        ]
      },
      "default": []
    },
    "user_current_outfit": {
      "type": "object",
      "description": "The user's currently active outfit for image generation.",
      "properties": {
        "outfit_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "top": {
          "type": "string"
        },
        "bottom": {
          "type": "string"
        },
        "shoes": {
          "type": "string"
        },
        "outerwear": {
          "type": "string"
        },
        "accessories": {
          "type": "string"
        },
        "hair_state": {
          "type": "string"
        },
        "full_description": {
          "type": "string"
        },
        "last_changed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "daily_weather_cache": {
      "type": "object",
      "description": "Cached daily weather data (sunrise, sunset, conditions) fetched at 4 AM ET",
      "properties": {
        "location": {
          "type": "string"
        },
        "sunrise": {
          "type": "string",
          "description": "HH:MM format"
        },
        "sunset": {
          "type": "string",
          "description": "HH:MM format"
        },
        "conditions": {
          "type": "string"
        },
        "high": {
          "type": "number"
        },
        "low": {
          "type": "number"
        },
        "fetchedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "world_context_cache": {
      "type": "object",
      "description": "Cached daily world context: news, entertainment, crime stats, health data, politics. Fetched at 5 AM ET. Used by narratives, character conversations, and world authenticity.",
      "properties": {
        "dateStr": {
          "type": "string",
          "format": "date"
        },
        "news": {
          "type": "object",
          "properties": {
            "headlines": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "category": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                }
              }
            },
            "politics": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "crime": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "economics": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "entertainment": {
          "type": "object",
          "properties": {
            "trending": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cultural": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "society": {
          "type": "object",
          "properties": {
            "crimeStats": {
              "type": "object"
            },
            "addictionTrends": {
              "type": "object"
            },
            "healthAlerts": {
              "type": "object"
            }
          }
        },
        "fetchedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "world_context_last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last world context fetch"
    },
    "holiday_observation_enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": []
}