{
  "name": "UserSettings",
  "type": "object",
  "properties": {
    "has_completed_onboarding": {
      "type": "boolean",
      "default": false
    },
    "default_character_id": {
      "type": "string"
    },
    "response_length": {
      "type": "string",
      "enum": [
        "short",
        "medium",
        "long"
      ],
      "default": "medium"
    },
    "emotional_intensity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "voice_enabled": {
      "type": "boolean",
      "default": false
    },
    "openai_api_key": {
      "type": "string",
      "description": "User's OpenAI API key for voice generation"
    },
    "voice_minutes_used": {
      "type": "number",
      "default": 0,
      "description": "Approximate minutes of voice generation used"
    },
    "user_birthday": {
      "type": "string",
      "format": "date",
      "description": "User's birthday (YYYY-MM-DD)"
    },
    "user_gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "non-binary",
        "other"
      ],
      "description": "User's gender"
    },
    "fictional_world_name": {
      "type": "string",
      "description": "The name the user goes by in the fictional world."
    },
    "response_lag_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether characters wait a realistic amount of time before responding"
    },
    "typing_speed_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether to simulate realistic typing speed before showing the message"
    },
    "words_per_minute": {
      "type": "number",
      "default": 41,
      "description": "Simulated typing speed in words per minute"
    },
    "user_schedule_notes": {
      "type": "string",
      "description": "User's general availability or schedule in natural language."
    },
    "user_balance": {
      "type": "number",
      "default": 6000,
      "description": "User's in-world financial balance (USD). Starting balance is $6,000."
    },
    "user_relatives": {
      "type": "object",
      "description": "Map of character IDs to their relationship to the user",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": []
}