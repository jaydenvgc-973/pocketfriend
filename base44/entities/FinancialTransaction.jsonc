{
  "name": "FinancialTransaction",
  "type": "object",
  "properties": {
    "character_id": {
      "type": "string",
      "description": "ID of the character this transaction belongs to"
    },
    "character_name": {
      "type": "string",
      "description": "Display name of the character"
    },
    "sender_id": {
      "type": "string",
      "description": "ID of the character or user initiating the transaction"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "user",
        "character",
        "system"
      ],
      "description": "Type of sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Display name of the sender"
    },
    "receiver_id": {
      "type": "string",
      "description": "ID of the character or user receiving the transaction"
    },
    "receiver_type": {
      "type": "string",
      "enum": [
        "user",
        "character",
        "system"
      ],
      "description": "Type of receiver"
    },
    "receiver_name": {
      "type": "string",
      "description": "Display name of the receiver"
    },
    "amount": {
      "type": "number",
      "description": "The amount of money (positive value)"
    },
    "direction": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ],
      "description": "Whether this is money coming in (income) or going out (expense) for the character"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "gift",
        "loan",
        "repayment",
        "purchase",
        "income",
        "rent",
        "utilities",
        "groceries",
        "gym",
        "tuition",
        "childcare",
        "bar_restaurant",
        "entertainment",
        "transport",
        "clothing",
        "healthcare",
        "simulated_need",
        "scene_purchase",
        "payroll",
        "location_operating_cost",
        "character_loan_given",
        "character_loan_received",
        "character_loan_repayment",
        "character_borrow_request",
        "character_borrow_denied",
        "other"
      ],
      "description": "Category of the financial transaction. 'location_operating_cost' = business owner charged for monthly operating costs (distinct from payroll, rent, utilities)."
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the transaction"
    },
    "location_id": {
      "type": "string",
      "description": "Optional: ID of the LocationReference where the transaction occurred"
    },
    "location_name": {
      "type": "string",
      "description": "Display name of the location"
    },
    "balance_after": {
      "type": "number",
      "description": "Character's balance after this transaction was applied"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp when the transaction occurred"
    },
    "loan_counterpart_id": {
      "type": "string",
      "description": "For loans: the character_id of the other party (lender or borrower). Used to track who owes whom."
    },
    "loan_counterpart_name": {
      "type": "string",
      "description": "Display name of the loan counterpart"
    },
    "loan_status": {
      "type": "string",
      "enum": [
        "outstanding",
        "partially_repaid",
        "repaid",
        "forgiven"
      ],
      "description": "For loan transactions: current repayment status"
    },
    "loan_original_amount": {
      "type": "number",
      "description": "Original loan amount (for tracking partial repayments)"
    }
  },
  "required": [
    "character_id",
    "amount",
    "direction",
    "transaction_type",
    "description",
    "timestamp"
  ]
}