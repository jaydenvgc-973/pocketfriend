{
  "name": "ClothingItem",
  "type": "object",
  "properties": {
    "owner_type": {
      "type": "string",
      "enum": [
        "user",
        "character"
      ],
      "description": "Who owns this item"
    },
    "owner_id": {
      "type": "string",
      "description": "Character ID or user email"
    },
    "item_name": {
      "type": "string",
      "description": "Display name (e.g. White Air Force 1s)"
    },
    "item_category": {
      "type": "string",
      "enum": [
        "shoes",
        "tops",
        "bottoms",
        "outerwear",
        "accessories",
        "jewelry",
        "bags",
        "hats",
        "sleepwear",
        "activewear",
        "underwear",
        "specialty"
      ],
      "description": "Primary category"
    },
    "subcategory": {
      "type": "string",
      "description": "e.g. sneakers, jeans, hoodie, chain"
    },
    "brand": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Full item description for styling and image generation"
    },
    "style_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "e.g. streetwear, sporty, luxury, casual"
    },
    "formality": {
      "type": "string",
      "enum": [
        "casual",
        "smart_casual",
        "business",
        "formal",
        "athletic",
        "loungewear"
      ],
      "default": "casual"
    },
    "purchase_price": {
      "type": "number",
      "default": 0
    },
    "purchased_from": {
      "type": "string",
      "description": "Store name or location"
    },
    "purchase_date": {
      "type": "string",
      "format": "date-time"
    },
    "image_url": {
      "type": "string",
      "description": "Photo of the item"
    },
    "is_owned": {
      "type": "boolean",
      "default": true
    },
    "is_favorite": {
      "type": "boolean",
      "default": false
    },
    "outfit_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Outfit IDs that reference this item"
    }
  },
  "required": [
    "owner_type",
    "owner_id",
    "item_name",
    "item_category"
  ]
}