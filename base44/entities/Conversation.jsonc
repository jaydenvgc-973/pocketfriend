{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Conversation title"
    },
    "type": {
      "type": "string",
      "enum": [
        "direct",
        "phone",
        "group",
        "npc"
      ],
      "default": "direct"
    },
    "character_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of characters in this conversation"
    },
    "participant_character_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Sorted array of both participants in bilateral conversations [A, B]"
    },
    "shared_conversation_key": {
      "type": "string",
      "description": "Deterministic key for bilateral conversations (bilateral_sortedIds_channel)"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the user who owns this conversation. Required for ownership scoping."
    },
    "channel": {
      "type": "string",
      "description": "Communication channel: world_phone, direct_text, scene, etc."
    },
    "last_message_preview": {
      "type": "string"
    },
    "last_message_date": {
      "type": "string",
      "format": "date-time"
    },
    "emotional_context": {
      "type": "string",
      "description": "Current emotional tone of conversation"
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "failed",
        "merged"
      ],
      "description": "Bilateral sync status for world phone conversations. 'merged' means this thread was consolidated into merged_into_conversation_id and should not evolve further."
    },
    "sync_error": {
      "type": "string",
      "description": "Error message if bilateral sync failed"
    },
    "merged_into_conversation_id": {
      "type": "string",
      "description": "If sync_status is 'merged', the canonical conversation ID this thread was consolidated into."
    },
    "merged_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when this conversation was archived/merged into the canonical thread."
    },
    "world_contact_mode": {
      "type": "string",
      "enum": [
        "active_created_to_active_created",
        "character_to_character",
        "character_to_npc"
      ],
      "description": "Mode classification for World Contacts conversations. Stamped at creation or backfilled."
    },
    "participant_character_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "character_type values of both participants at conversation creation time."
    },
    "generation_lock": {
      "type": "object",
      "description": "Durable lock state for character response generation. Stores idempotency and recovery metadata.",
      "additionalProperties": true,
      "properties": {
        "lock_id": {
          "type": "string",
          "description": "Unique lock identifier for this generation cycle"
        },
        "generation_in_progress": {
          "type": "boolean",
          "default": false,
          "description": "True when character response is being generated. Blocks concurrent requests."
        },
        "generation_started_at": {
          "type": "string",
          "format": "date-time",
          "description": "When generation began. Used to detect stale locks."
        },
        "generation_released_at": {
          "type": "string",
          "format": "date-time",
          "description": "When lock was released. Used to track completion time."
        },
        "character_id": {
          "type": "string",
          "description": "ID of character this lock protects"
        },
        "channel": {
          "type": "string",
          "description": "Communication channel (direct, phone, world_phone, etc.)"
        },
        "source_message_id": {
          "type": "string",
          "description": "ID of user message that triggered this generation"
        },
        "owner_email": {
          "type": "string",
          "description": "Owner email for scoping"
        },
        "fallback_detected": {
          "type": "boolean",
          "default": false,
          "description": "True if LLM failed and fallback was used"
        },
        "fallback_count": {
          "type": "integer",
          "default": 0,
          "description": "Number of fallback signals shown for this response"
        },
        "fallback_blocked": {
          "type": "boolean",
          "default": false,
          "description": "True if duplicate fallback was blocked. Triggers recovery."
        },
        "last_fallback_text": {
          "type": "string",
          "description": "Truncated text of last fallback shown"
        },
        "last_fallback_at": {
          "type": "string",
          "format": "date-time",
          "description": "When last fallback was shown"
        },
        "recovery_required": {
          "type": "boolean",
          "default": false,
          "description": "True if recovery pipeline should run"
        },
        "recovery_started_at": {
          "type": "string",
          "format": "date-time",
          "description": "When recovery was triggered"
        },
        "last_recovery_attempt_at": {
          "type": "string",
          "format": "date-time",
          "description": "When recovery was last attempted"
        },
        "recovery_completed_at": {
          "type": "string",
          "format": "date-time",
          "description": "When recovery successfully completed"
        },
        "real_pipeline_restored": {
          "type": "boolean",
          "default": false,
          "description": "True if real LLM response was recovered"
        },
        "last_blocking_stage": {
          "type": "string",
          "description": "Which stage blocked (canonical_prompt, llm_call, message_save, etc.)"
        },
        "stale_lock": {
          "type": "boolean",
          "default": false,
          "description": "True if lock exceeded TTL and was auto-released"
        },
        "stale_released_at": {
          "type": "string",
          "format": "date-time",
          "description": "When stale lock was auto-released"
        },
        "cooldown_until": {
          "type": "string",
          "format": "date-time",
          "description": "Do not attempt new generation until this time (circuit breaker)"
        },
        "recovery_stages": {
          "type": "object",
          "description": "Diagnostic data for each recovery stage",
          "additionalProperties": true
        }
      }
    }
  },
  "required": [
    "title",
    "type",
    "character_ids"
  ]
}