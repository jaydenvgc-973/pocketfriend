{
  "name": "ScheduledEvent",
  "type": "object",
  "properties": {
    "character_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of characters involved in this event"
    },
    "character_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Display names of characters involved"
    },
    "description": {
      "type": "string",
      "description": "A natural language description of the event"
    },
    "trigger_time": {
      "type": "string",
      "format": "date-time",
      "description": "The exact UTC time when this event should occur"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "conversation_id": {
      "type": "string",
      "description": "Conversation ID to log the narrative message into when triggered"
    },
    "primary_character_id": {
      "type": "string",
      "description": "The main character whose chat this event surfaces in"
    },
    "type": {
      "type": "string",
      "enum": [
        "narrative",
        "internal",
        "travel_arrival",
        "communication_promise"
      ],
      "default": "narrative",
      "description": "narrative = shown to user in chat; internal = updates character state only; travel_arrival = character arrives at destination; communication_promise = character sends promised text/call"
    },
    "source": {
      "type": "string",
      "enum": [
        "chat",
        "simulation",
        "narrator",
        "commitment"
      ],
      "description": "Where this event was created from"
    },
    "event_payload": {
      "type": "object",
      "description": "Type-specific payload data. For travel_arrival: {destination_location_id, destination_location_name, commitment_id}. For communication_promise: {commitment_id, promised_action, recipient_type, recipient_character_id}.",
      "additionalProperties": true
    },
    "owner_email": {
      "type": "string",
      "description": "Owner email for scoping"
    }
  },
  "required": [
    "character_ids",
    "description",
    "trigger_time"
  ]
}