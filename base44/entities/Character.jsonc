          },
          "added_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "videos_watched": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "creator": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "duration": {
            "type": "string"
          },
          "link": {
            "type": "string"
          },
          "added_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "future_life_goals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "personal_development",
              "health_wellness",
              "career_financial",
              "relationships_family",
              "adventure_travel",
              "giving_back_spiritual"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "achieved",
              "on_hold",
              "abandoned"
            ],
            "default": "active"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "default": "medium"
          },
          "details": {
            "type": "string"
          },
          "revealed_to_user": {
            "type": "boolean",
            "default": false
          },
          "achieved_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
