              "personal_development",
              "health_wellness",
              "career_financial",
              "relationships_family",
              "adventure_travel",
              "giving_back_spiritual"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "achieved",
              "on_hold",
              "abandoned"
            ],
            "default": "active"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "default": "medium"
          },
          "details": {
            "type": "string"
          },
          "revealed_to_user": {
            "type": "boolean",
            "default": false
          },
          "achieved_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "user_respect_level": {
      "type": "number",
      "default": 50
    },
    "friendship_level": {
      "type": "number",
      "default": 75
    },
    "romantic_level": {
      "type": "number",
      "default": 0
    },
    "attraction_level": {
      "type": "number",
      "default": 0
    },
    "chosen_family_level": {
      "type": "number",
      "default": 0
    },
    "is_active_character": {
      "type": "boolean",
      "default": false
    },
    "merged_into_character_id": {
      "type": "string"
    },
    "schedule_profile_id": {
      "type": "string"
    },
    "messaging_profile_id": {
      "type": "string"
    },
    "relationship_state_id": {
      "type": "string"
    },
    "hunger_value": {
      "type": "number",
      "default": 70
    },
    "energy_value": {
      "type": "number",
      "default": 75
    },
    "social_value": {
      "type": "number",
      "default": 65
    },
    "health_value": {
      "type": "number",
      "default": 80
    },
    "mental_value": {
      "type": "number",
      "default": 70
    },
    "financial_need_value": {
      "type": "number",
      "default": 60
    },
    "hygiene_value": {
      "type": "number",
      "default": 75
    },
    "comfort_value": {
      "type": "number",
      "default": 70
    },
    "last_need_simulated_at": {
      "type": "string",
      "format": "date-time"
    },
    "needs_initialized": {
      "type": "boolean",
      "default": false
    },
    "is_jailed": {
      "type": "boolean",
      "default": false,
      "description": "True if character is currently serving jail time \u2014 blocks all actions, invites, travel, and chat"
    },
    "jail_release_date": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp when jail sentence ends and character is automatically released"
    },
    "jail_sentence_days": {
      "type": "number",
      "default": 7,
      "description": "Number of days this jail sentence lasts"
    },
    "jailed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the character was jailed"
    }
  },
  "required": [
    "name"
  ]
}