    "health_status": {
      "type": "string"
    },
    "health_habits": {
      "type": "string"
    },
    "criminal_record": {
      "type": "string"
    },
    "system_prompt": {
      "type": "string"
    },
    "work_details": {
      "type": "object",
      "properties": {
        "job_title": {
          "type": "string"
        },
        "workplace_type": {
          "type": "string"
        },
        "work_environment": {
          "type": "string"
        },
        "coworker_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "occupation_location_id": {
      "type": "string"
    },
    "occupation_location_name": {
      "type": "string"
    },
    "additional_occupation_locations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "location_id": {
            "type": "string"
          },
          "location_name": {
            "type": "string"
          },
          "job_title": {
            "type": "string"
          }
        }
      }
    },
    "education_location_id": {
      "type": "string"
    },
