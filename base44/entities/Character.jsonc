    "merged_into_character_id": {
      "type": "string"
    },
    "schedule_profile_id": {
      "type": "string"
    },
    "messaging_profile_id": {
      "type": "string"
    },
    "relationship_state_id": {
      "type": "string"
    },
    "system_prompt_url": {
      "type": "string"
    },
    "hunger_value": {
      "type": "number",
      "default": 70
    },
    "energy_value": {
      "type": "number",
      "default": 75
    },
    "social_value": {
      "type": "number",
      "default": 65
    },
    "health_value": {
      "type": "number",
      "default": 80
    },
    "mental_value": {
      "type": "number",
      "default": 70
    },
    "financial_need_value": {
      "type": "number",
      "default": 60
    },
    "hygiene_value": {
      "type": "number",
      "default": 75
    },
    "comfort_value": {
      "type": "number",
      "default": 70
    },
    "last_need_simulated_at": {
      "type": "string",
      "format": "date-time"
    },
    "needs_initialized": {
      "type": "boolean",
      "default": false
    },
    "is_jailed": {
      "type": "boolean",
      "default": false,
      "description": "True when character is currently incarcerated. Blocks all autonomous movement and civilian routing."
    },
    "jail_release_date": {
      "type": "string",
      "format": "date-time",
      "description": "When incarceration ends (if known)."
    },
    "jail_sentence_days": {
      "type": "number",
      "default": 7,
      "description": "Length of sentence in days."
    },
    "jailed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When incarceration began."
    },
    "incarceration_facility_id": {
      "type": "string",
      "description": "ID of the LocationReference for the jail/prison/facility. May be null if rabbit hole confinement."
    },
    "incarceration_facility_name": {
      "type": "string",
      "description": "Display name of the confinement facility (used when facility_id is null/rabbit hole)."
    },
    "incarceration_status": {
      "type": "string",
      "enum": [
        "pretrial",
        "sentenced",
        "serving",
        "work_release",
        "solitary",
        "transferred",
        "released",
        "paroled",
        "probation_only"
      ],
      "description": "Current status within the criminal justice system."
    },
    "parole_status": {
      "type": "string",
      "enum": [
        "none",
        "eligible",
        "on_parole",
        "parole_revoked",
        "completed"
      ],
      "default": "none",
      "description": "Parole status after or during incarceration."
    },
    "probation_status": {
      "type": "string",
      "enum": [
        "none",
        "on_probation",
        "probation_violated",
        "completed"
      ],
      "default": "none",
      "description": "Probation status."
    },
    "house_arrest_active": {
      "type": "boolean",
      "default": false,
      "description": "True when character is under house arrest. Restricts movement to assigned residence."
    },
    "house_arrest_location_id": {
      "type": "string",
      "description": "The residence location ID where house arrest is served."
    },
    "house_arrest_end_date": {
      "type": "string",
      "format": "date-time",
      "description": "When house arrest ends."
    },
    "pending_charges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of pending criminal charges."
    },
    "court_date": {
      "type": "string",
      "format": "date-time",
      "description": "Next scheduled court date."
    },
    "owner_user_id_legacy": {
      "type": "string"
    },
    "presence_state": {
      "type": "string",
      "description": "VGC travel state: 'social_visit' when NPC is out on a VGC travel assignment, 'home' when returned. Used by distributeVGCTowersNPCs rotation cooldown check."
    },
    "valid_from": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the current VGC location assignment became active. Used to enforce the 90-minute rotation cooldown before re-assigning."
    },
    "last_vgc_travel_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time this NPC was assigned a VGC travel destination. Used for fairness ordering: NPCs who waited longest travel first next run."
    },
    "return_location_id": {
      "type": "string",
      "description": "The home location ID this NPC should return to after VGC travel ends (set to VGC Towers ID)."
    },
    "next_move_at": {
      "type": "string",
      "format": "date-time",
      "description": "Scheduled time for next VGC travel movement. Informational only \u2014 actual scheduling is driven by the 2-hour automation."
    },
    "vgc_travel_day_active": {
      "type": "boolean",
      "default": false,
      "description": "True when the NPC is in an active VGC travel day cycle."
    },
    "current_travel_block": {
      "type": "string",
      "description": "Current VGC travel block label: MORNING, AFTERNOON, EVENING, or WRAPUP."
    },
    "source_of_move": {
      "type": "string",
      "description": "What triggered the last location change: 'system' for VGC travel automation, 'user' for manual moves."
    },
    "presence_reason": {
      "type": "string",
      "description": "Reason label for current presence state: vgc_distribution, vgc_rotation, lockdown_rest, etc."
    },
    "valid_until": {
      "type": "string",
      "format": "date-time",
      "description": "When the current VGC location assignment expires. NPC may be re-assigned after this time."
    }
  },
  "required": [
    "name"
  ]
}