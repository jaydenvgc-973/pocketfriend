    },
    "wake_up_time": {
      "type": "string"
    },
    "sleep_interrupted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the character's sleep was last interrupted (alarm, emergency, etc.)"
    },
    "pending_alarm_time": {
      "type": "string",
      "format": "date-time",
      "description": "ISO datetime of a scheduled alarm. Cleared when the alarm fires or is canceled. Scoped to owner_email only."
    },
    "alarm_woke_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the scheduled alarm last successfully woke this character. Written by processScheduledCharacterAlarms."
    },
    "last_wake_time": {
      "type": "string",
      "format": "date-time",
      "description": "When the character last completed actual sleep (not nap) and became awake. Written by simulateActiveCharacterNeeds sleep cap and other wake-from-actual-sleep transitions. Used as the authoritative timer-start for 19-hour awake enforcement. Naps do NOT update this field."
    },
    "work_start_time": {
      "type": "string"
    },
    "work_end_time": {
      "type": "string"
    },
