    "user_respect_level": {
      "type": "number",
      "default": 50
    },
    "friendship_level": {
      "type": "number",
      "default": 75
    },
    "romantic_level": {
      "type": "number",
      "default": 0
    },
    "attraction_level": {
      "type": "number",
      "default": 0
    },
    "chosen_family_level": {
      "type": "number",
      "default": 0
    },
    "character_type": {
      "type": "string",
      "enum": [
        "npc",
        "active",
        "default",
        "protected",
        "user_created",
        "merged_alias"
      ],
      "default": "user_created"
    },
    "is_protected": {
      "type": "boolean",
      "default": false
    },
    "is_active_character": {
      "type": "boolean",
      "default": false
    },
    "merged_into_character_id": {
      "type": "string"
    },
    "schedule_profile_id": {
      "type": "string"
    },
    "messaging_profile_id": {
      "type": "string"
    },
    "relationship_state_id": {
      "type": "string"
