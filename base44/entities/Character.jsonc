{
  "name": "Character",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Character display name"
    },
    "nickname_for_user": {
      "type": "string",
      "description": "The name this character uses when referring to or addressing the user."
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "is_finalized": {
      "type": "boolean",
      "default": false,
      "description": "True once character creation is complete. Fields are locked."
    },
    "is_photogenic": {
      "type": "boolean",
      "default": false
    },
    "trait_oversharer": {
      "type": "boolean",
      "default": false
    },
    "trait_dry_humor": {
      "type": "boolean",
      "default": false
    },
    "trait_night_owl": {
      "type": "boolean",
      "default": false
    },
    "trait_hot_and_cold": {
      "type": "boolean",
      "default": false
    },
    "trait_flirty": {
      "type": "boolean",
      "default": false
    },
    "trait_overcorrects": {
      "type": "boolean",
      "default": false
    },
    "trait_blunt": {
      "type": "boolean",
      "default": false
    },
    "trait_easily_distracted": {
      "type": "boolean",
      "default": false
    },
    "trait_romanticizes": {
      "type": "boolean",
      "default": false
    },
    "trait_hard_to_read": {
      "type": "boolean",
      "default": false
    },
    "trait_competitive": {
      "type": "boolean",
      "default": false
    },
    "lives_alone": {
      "type": "boolean",
      "default": false
    },
    "birthday": {
      "type": "string",
      "format": "date"
    },
    "zodiac_sign": {
      "type": "string"
    },
    "religion": {
      "type": "string",
      "default": "None"
    },
    "belief_level": {
      "type": "string",
      "enum": [
        "in_name_only",
        "moderate",
        "devout"
      ],
      "default": "moderate"
    },
    "religion_custom": {
      "type": "string"
    },
    "sleep_start_time": {
      "type": "string"
    },
    "wake_up_time": {
      "type": "string"
    },
    "work_start_time": {
      "type": "string"
    },
    "work_end_time": {
      "type": "string"
    },
    "work_days": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 6
      }
    },
    "current_activity": {
      "type": "string"
    },
    "weather_summary": {
      "type": "string"
    },
    "weather_last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "voice_enabled": {
      "type": "boolean",
      "default": true
    },
    "voice_name": {
      "type": "string",
      "default": "alloy"
    },
    "voice_style_note": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "moved_away",
        "deleted",
        "soft_deleted",
        "merged"
      ],
      "default": "active"
    },
    "student_status": {
      "type": "string",
      "enum": [
        "not_student",
        "enrolled",
        "on_break",
        "graduated",
        "dropped"
      ],
      "default": "not_student"
    },
    "avatar_url": {
      "type": "string"
    },
    "reference_image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "avatar_description_text": {
      "type": "string"
    },
    "avatar_generation_prompt": {
      "type": "string"
    },
    "fictional_entity_images": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "scene_images": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "appearance_notes": {
      "type": "string"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "non-binary",
        "other"
      ]
    },
    "age_range": {
      "type": "string"
    },
    "ethnicities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "archetype": {
      "type": "string"
    },
    "social_energy": {
      "type": "string",
      "enum": [
        "introvert",
        "mostly_introvert",
        "ambivert",
        "mostly_extrovert",
        "extrovert"
      ]
    },
    "sexual_orientation": {
      "type": "string"
    },
    "personality_summary": {
      "type": "string"
    },
    "personality_traits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "communication_style": {
      "type": "string"
    },
    "emotional_triggers_high": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "emotional_triggers_medium": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "emotional_triggers_deep": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "background_story": {
      "type": "string"
    },
    "current_situation": {
      "type": "string"
    },
    "family_history": {
      "type": "string"
    },
    "family_members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "relationship_type": {
            "type": "string"
          },
          "photo_url": {
            "type": "string"
          },
          "age_at_creation": {
            "type": "number"
          },
          "age_set_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "loyalty_view": {
      "type": "string"
    },
    "upset_reaction": {
      "type": "string"
    },
    "emotional_baggage": {
      "type": "string"
    },
    "emotional_state": {
      "type": "string",
      "enum": [
        "calm",
        "irritated",
        "defensive",
        "reflective",
        "closed-off",
        "flirtatious",
        "bored",
        "burnt out",
        "joyful",
        "anxious",
        "sad",
        "excited",
        "overwhelmed",
        "content",
        "frustrated",
        "joy",
        "happiness",
        "contentment",
        "excitement",
        "elation",
        "hope",
        "relief",
        "gratitude",
        "love",
        "affection",
        "compassion",
        "empathy",
        "pride",
        "confidence",
        "peacefulness",
        "satisfaction",
        "curiosity",
        "interest",
        "amusement",
        "surprise",
        "awe",
        "anticipation",
        "nostalgia",
        "longing",
        "desire",
        "passion",
        "infatuation",
        "tenderness",
        "vulnerability",
        "trust",
        "security",
        "belonging",
        "acceptance",
        "patience",
        "annoyance",
        "irritation",
        "anger",
        "rage",
        "resentment",
        "jealousy",
        "envy",
        "insecurity",
        "doubt",
        "confusion",
        "stress",
        "fear",
        "panic",
        "worry",
        "guilt",
        "shame",
        "embarrassment",
        "regret",
        "disappointment",
        "grief",
        "loneliness",
        "hopelessness",
        "despair",
        "detachment",
        "numbness",
        "apathy"
      ],
      "default": "calm"
