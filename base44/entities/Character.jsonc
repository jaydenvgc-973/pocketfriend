      "type": "string",
      "default": "none"
    },
    "job_training_start_date": {
      "type": "string",
      "format": "date-time"
    },
    "job_training_expected_completion_date": {
      "type": "string",
      "format": "date-time"
    },
    "job_training_details": {
      "type": "object",
      "properties": {
        "training_name": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "position_title": {
          "type": "string"
        },
        "duration_days": {
          "type": "number"
        }
      }
    },
    "completed_education": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "course_name": {
            "type": "string"
          },
          "institution": {
            "type": "string"
          },
          "completion_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "completed_job_training": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "training_name": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "position_title": {
            "type": "string"
          },
          "completion_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "songs_heard": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "spotify_id": {
            "type": "string"
          },
          "lyrics_excerpt": {
            "type": "string"
          },
          "full_lyrics": {
            "type": "string"
          },
