    "current_education_activity": {
      "type": "string",
      "default": "none"
    },
    "education_start_date": {
      "type": "string",
      "format": "date-time"
    },
    "education_expected_completion_date": {
      "type": "string",
      "format": "date-time"
    },
    "education_details": {
      "type": "object",
      "properties": {
        "course_name": {
          "type": "string"
