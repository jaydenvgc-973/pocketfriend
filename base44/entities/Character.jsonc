{
  "name": "Character",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Character display name"
    },
    "primary_name": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "normalized": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "nickname",
              "family_role",
              "descriptor",
              "title",
              "contextual_name",
              "short_name",
              "alternate_spelling"
            ]
          },
          "source_context_type": {
            "type": "string",
            "enum": [
              "chat",
              "text",
              "location",
              "media",
              "memory_import",
              "manual_user_entry"
            ]
          },
          "location_scope_id": {
            "type": "string"
          },
          "relationship_scope_character_id": {
            "type": "string"
          },
          "user_confirmed": {
            "type": "boolean",
            "default": false
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    },
    "character_type": {
      "type": "string",
      "enum": [
        "active",
        "npc",
        "family_npc",
        "background",
        "promoted_npc"
      ],
      "default": "active"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "moved_away",
        "deleted",
        "soft_deleted",
        "merged"
      ],
      "default": "active"
    },
    "age": {
      "type": "number"
    },
    "birth_year": {
      "type": "number"
    },
    "zodiac_sign": {
      "type": "string"
    },
    "profile_summary": {
      "type": "string"
    },
    "backstory": {
      "type": "string"
    },
    "occupation": {
      "type": "string"
    },
    "education": {
      "type": "string"
    },
    "current_home_location_id": {
      "type": "string"
    },
    "current_work_location_id": {
      "type": "string"
    },
    "current_school_location_id": {
      "type": "string"
    },
    "resolved_current_location_id": {
      "type": "string"
    },
    "resolved_current_location_name": {
      "type": "string"
    },
    "resolved_location_type": {
      "type": "string",
      "enum": [
        "home",
        "work",
        "school",
        "visit",
        "traveling",
        "supervision_home",
        "recovery_nap"
      ]
    },
    "resolved_presence_status": {
      "type": "string",
      "enum": [
        "home",
        "at_work",
        "at_school",
        "visiting",
        "traveling",
        "under_supervision",
        "sleeping",
        "napping"
      ]
    },
    "resolved_source_reason": {
      "type": "string"
    },
    "resolved_last_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "traveling_to_location_id": {
      "type": "string"
    },
    "traveling_to_location_name": {
      "type": "string"
    },
    "location_status": {
      "type": "string",
      "enum": [
        "at_location",
        "traveling",
        "home",
        "unavailable"
      ],
      "default": "home"
    },
    "last_location_update_time": {
      "type": "string",
      "format": "date-time"
    },
    "last_arrived_time": {
      "type": "string",
      "format": "date-time"
    },
    "location_visibility_state": {
      "type": "string",
      "enum": [
        "visible",
        "hidden",
        "in_scene",
        "unreachable"
      ],
      "default": "visible"
    },
    "pending_invite_id": {
      "type": "string"
    },
    "schedule_override_active": {
      "type": "boolean",
      "default": false
    },
    "return_to_schedule_after_outing": {
      "type": "string"
    },
    "recent_location_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "location_id": {
            "type": "string"
          },
          "location_name": {
            "type": "string"
          },
          "arrived_at": {
            "type": "string",
            "format": "date-time"
          },
          "left_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    },
    "travel_status": {
      "type": "string",
      "enum": [
        "not_traveling",
        "traveling_to_work",
        "traveling_to_school",
        "traveling_to_destination"
      ],
      "default": "not_traveling"
    },
    "travel_destination_location_id": {
      "type": "string"
    },
    "sleep_debt_hours": {
      "type": "number",
      "default": 0
    },
    "last_sleep_start": {
      "type": "string",
      "format": "date-time"
    },
    "last_nap_time": {
      "type": "string",
      "format": "date-time"
    },
    "image_avatar_url": {
      "type": "string"
    },
    "alias_count": {
      "type": "integer",
      "default": 0
    },
    "relationship_count": {
      "type": "integer",
      "default": 0
    },
    "is_protected": {
      "type": "boolean",
      "default": false
    },
    "created_by_user": {
      "type": "boolean",
      "default": true
    },
    "protected_active": {
      "type": "boolean",
      "default": false
    },
    "nickname_for_user": {
      "type": "string"
    },
    "appearance_age": {
      "type": "number"
    },
    "appearance_lock": {
      "type": "object",
