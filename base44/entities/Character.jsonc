          "tuition_amount": {
            "type": "number"
          },
          "scholarship_enabled": {
            "type": "boolean",
            "default": false
          },
          "enroll_date": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended",
              "graduated",
              "dropped"
            ],
            "default": "active"
          }
        }
      },
      "default": []
    },
    "frequented_places": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fictional_relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "person_name": {
            "type": "string"
          },
          "related_character_id": {
            "type": "string"
          },
          "relationship_type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "current_status": {
            "type": "string"
          },
          "emotional_impact": {
            "type": "string"
          },
          "last_interaction_summary": {
            "type": "string"
          },
          "history_summary": {
            "type": "string"
          },
          "avatar_url": {
            "type": "string"
          },
          "user_respect_level": {
            "type": "number",
            "default": 50
          },
          "friendship_level": {
            "type": "number",
            "default": 75
          },
          "romantic_level": {
            "type": "number",
            "default": 0
          },
          "attraction_level": {
            "type": "number",
            "default": 0
          },
          "chosen_family_level": {
            "type": "number",
            "default": 0
          }
        }
      }
    },
    "transient_encounters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "emotional_reaction": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      }
    },
    "current_life_event": {
      "type": "string"
    },
    "daily_micro_narration": {
      "type": "string",
      "description": "1\u20133 short third-person sentences describing what the character is doing right now. Strictly third-person (he/she/they/name). Updated by life simulation."
    },
    "life_last_updated": {
      "type": "string"
    },
    "departed_characters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "cause": {
            "type": "string"
          },
          "relationship_closeness": {
            "type": "string"
          }
        }
      }
    },
    "triggered_milestones": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
