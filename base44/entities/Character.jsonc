{
  "name": "Character",
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "data.owner_email": "{{user.email}}"
    },
    "update": {
      "data.owner_email": "{{user.email}}"
    },
    "delete": {
      "data.owner_email": "{{user.email}}"
    }
  },
  "properties": {
    "sleep_lock": {
      "type": "boolean",
      "default": false,
      "description": "Vick Servicio only. When true, energy/sleep simulation is frozen. No decay or recovery. Resumes from current value when turned off."
    },
    "hunger_lock": {
      "type": "boolean",
      "default": false,
      "description": "Vick Servicio only. When true, hunger simulation is frozen. No decay or recovery. Resumes from current value when turned off."
    },
    "presence_stay_lock": {
      "type": "boolean",
      "default": false,
      "description": "True when user explicitly chose STAY for this character at a scene exit. Automations must not override the resolved location while this is true."
    },
    "presence_stay_lock_location_id": {
      "type": "string",
      "description": "The location ID where the character is locked by user STAY decision."
    },
    "presence_stay_lock_set_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the stay lock was set. VGC Towers travel logic uses this to know when to clear the lock."
    },
    "presence_stay_lock_reason": {
      "type": "string",
      "description": "Why the lock exists (e.g., user_scene_stay, sleep_state, work_shift, school_schedule)."
    },
    "presence_stay_lock_authority": {
      "type": "string",
      "description": "Which system set the lock (e.g., SceneExit, simulateActiveCharacterNeeds, enforceCharacterWorkSchedule)."
    },
    "presence_stay_lock_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the lock automatically expires. Null for locks that release on condition."
    },
    "presence_stay_lock_release_condition": {
      "type": "string",
      "description": "Programmatic condition for release (e.g., sleep_complete, shift_end, scene_end)."
    },
    "presence_stay_lock_created_by": {
      "type": "string",
      "description": "Who initiated the lock (user or system_automation)."
    },
    "character_type": {
      "type": "string",
      "enum": [
        "active_created_character",
        "npc_regular",
        "npc_family_member",
        "npc_fictitious",
        "npc_world_service"
      ],
      "default": "active_created_character",
      "description": "World-behavior and system-routing class. npc_world_service = permanent seeded world-service characters like Vick Servicio. They are protected from deletion, archival, merging, and cleanup targeting."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "moved_away",
        "deleted",
        "soft_deleted",
        "merged"
      ],
      "default": "active"
    },
    "owner_user_id": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "created_by_role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ]
    },
    "data_scope": {
      "type": "string",
      "enum": [
        "private_user",
        "shared",
        "system_global"
      ],
      "default": "private_user"
    },
    "visibility_scope": {
      "type": "string",
      "enum": [
        "account_private",
        "shared_npc",
        "admin_global"
      ],
      "default": "account_private"
    },
    "name": {
      "type": "string"
    },
    "primary_name": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "is_test_character": {
      "type": "boolean",
      "default": false
    },
    "diagnostic_only": {
      "type": "boolean",
      "default": false
    },
    "exclude_from_homepage": {
      "type": "boolean",
      "default": false
    },
    "exclude_from_default_scene_queries": {
      "type": "boolean",
      "default": false
    },
    "exclude_from_roster": {
      "type": "boolean",
      "default": false
    },
    "is_world_service": {
      "type": "boolean",
      "default": false,
      "description": "True for permanent world-service characters (e.g. Vick Servicio). Blocks deletion, archival, merging, and cleanup targeting."
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "age": {
      "type": "number"
    },
    "birth_year": {
      "type": "number"
    },
    "birthday": {
      "type": "string",
      "format": "date"
    },
    "zodiac_sign": {
      "type": "string"
    },
    "appearance_age": {
      "type": "number"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "non-binary",
        "other"
      ]
    },
    "ethnicities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "avatar_url": {
      "type": "string"
    },
    "image_avatar_url": {
      "type": "string"
    },
    "reference_image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "avatar_description_text": {
      "type": "string"
    },
    "avatar_generation_prompt": {
      "type": "string"
    },
    "appearance_notes": {
      "type": "string"
    },
