{
  "name": "UserAchievementEvent",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who triggered the event (for user-scoped tracking)"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "message_sent",
        "message_received",
        "reply_sent",
        "quick_reply",
        "conversation_started",
        "new_character_created",
        "first_message_to_character",
        "emoji_reaction",
        "supportive_comment",
        "image_sent",
        "character_interaction",
        "conversation_duration",
        "streak_activity",
        "character_reached_status",
        "relationship_level_change"
      ],
      "description": "Type of user action"
    },
    "achievement_id": {
      "type": "string",
      "description": "Which achievement this event might contribute to (can be null for multi-use events)"
    },
    "character_id": {
      "type": "string",
      "description": "Which character this event involves (if applicable)"
    },
    "conversation_id": {
      "type": "string",
      "description": "Which conversation this event occurred in (if applicable)"
    },
    "message_id": {
      "type": "string",
      "description": "Which message this event is about (if applicable)"
    },
    "metadata": {
      "type": "object",
      "description": "Event-specific data (timestamps, content previews, relationship levels, etc.)",
      "additionalProperties": true
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the event occurred"
    }
  },
  "required": [
    "user_email",
    "event_type",
    "timestamp"
  ]
}