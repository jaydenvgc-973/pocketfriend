{
  "name": "GatheringRoom",
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name of the Gathering Room"
    },
    "description": {
      "type": "string",
      "description": "Short description of the room's vibe and purpose"
    },
    "image_url": {
      "type": "string",
      "description": "Base scene image URL for the room"
    },
    "image_prompt": {
      "type": "string",
      "description": "Prompt used to generate the base scene image"
    },
    "scene_image_url": {
      "type": "string",
      "description": "Dynamically generated scene image reflecting current occupants. Updated when room composition changes."
    },
    "scene_image_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the dynamic scene image was last generated"
    },
    "category": {
      "type": "string",
      "enum": [
        "social",
        "entertainment",
        "relaxation",
        "creative",
        "celebration",
        "other"
      ],
      "default": "social",
      "description": "Category affecting scene ambiance"
    },
    "vibe": {
      "type": "string",
      "enum": [
        "quiet",
        "social",
        "energetic",
        "mixed"
      ],
      "default": "social",
      "description": "Atmosphere/energy level"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this room is available for admission"
    },
    "max_capacity": {
      "type": "integer",
      "default": 8,
      "minimum": 2,
      "maximum": 8,
      "description": "Hard maximum total participants (users + characters combined)"
    },
    "current_occupancy": {
      "type": "integer",
      "default": 0,
      "description": "Backend-authoritative current occupancy count. Updated by backend functions whenever membership changes. Counts only participants from active, non-expired sessions. The client reads this sanitized number \u2014 never raw session/participant records."
    },
    "is_full": {
      "type": "boolean",
      "default": false,
      "description": "True when current_occupancy >= max_capacity. Backend-authoritative."
    },
    "gathering_epoch": {
      "type": "string",
      "format": "date-time",
      "description": "Start timestamp of the current gathering. Messages with timestamp < gathering_epoch belong to a previous gathering and are excluded from the live transcript. Set on first admission; reset to a new value when the room has been continuously empty for 30+ minutes (expired gathering). This scopes the live 20-message window to the CURRENT gathering only \u2014 past gatherings do not repopulate the active room. Character memory is unaffected: lived experiences are preserved through the canonical Memory entity independently of this field."
    },
    "last_emptied_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the room last transitioned to zero valid participants. Used by admitToGatheringRoom to detect the 30-minute empty-room expiration boundary. Set by recalculateGatheringRoomOccupancy when occupancy reaches 0; cleared when occupancy rises above 0."
    },
    "sort_order": {
      "type": "integer",
      "default": 0,
      "description": "Display order on Travel page"
    },
    "active_media": {
      "type": "object",
      "description": "Current shared media activity in the room. Null when no media is active.",
      "properties": {
        "media_type": {
          "type": "string",
          "enum": [
            "video",
            "music",
            "image",
            "none"
          ]
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "thumbnail": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "embed_type": {
          "type": "string",
          "enum": [
            "iframe",
            "video"
          ],
          "description": "Playback rendering type: 'iframe' for embeddable players (YouTube, Vimeo, etc.), 'video' for direct media files (MP4, WebM). Determines whether the player renders an <iframe> or a <video> element."
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "started_by_participant_name": {
          "type": "string"
        }
      }
    },
    "created_by": {
      "type": "string",
      "description": "Admin who created this room"
    }
  },
  "required": [
    "name"
  ]
}