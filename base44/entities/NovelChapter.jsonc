{
  "name": "NovelChapter",
  "type": "object",
  "description": "One generated chapter of a novel, with its own prose and illustrations. Novel-owned record only.",
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "properties": {
    "novel_id": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "chapter_number": {
      "type": "number"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "Chapter prose. Paragraphs are separated by blank lines; illustrations are anchored by paragraph index."
    },
    "summary": {
      "type": "string",
      "description": "Short continuity summary used when writing later chapters"
    },
    "direction": {
      "type": "string",
      "description": "The chapter-specific premise this chapter was written from. Retained so a Redo can offer it back for review and editing."
    },
    "writing_state": {
      "type": "string",
      "enum": [
        "complete",
        "writing"
      ],
      "default": "complete",
      "enumColors": [
        "green",
        "yellow"
      ],
      "description": "writing = only the opening of this chapter is saved and the finishing stage has not completed yet. complete = the whole chapter is written."
    },
    "writing_brief": {
      "type": "object",
      "description": "The material the opening of this chapter was built from, by record ID: the subject, the period, and the exact memories, life events, story events, relationships and conversations selected for it. The finishing request reads this instead of planning the selection a second time. Empty on complete chapters.",
      "properties": {
        "subject": {
          "type": "string"
        },
        "period": {
          "type": "string"
        },
        "memory_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "life_event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "story_event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relationship_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "message_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "previous_version": {
      "type": "object",
      "description": "While a Redo is in progress, the version of this chapter it is replacing. The replaced chapter's prose, illustrations and stored premise are kept here until the replacement is written and saved; if the redo fails, they are put back exactly as they were. Empty otherwise.",
      "properties": {
        "content": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "word_count": {
          "type": "number"
        },
        "illustrations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              },
              "caption": {
                "type": "string"
              },
              "after_paragraph": {
                "type": "number"
              }
            }
          }
        },
        "illustration_specs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "direction": {
          "type": "string"
        },
        "saved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "word_count": {
      "type": "number"
    },
    "illustrations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          },
          "after_paragraph": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "illustration_specs": {
      "type": "array",
      "description": "Plates chosen by the writer, with their people and place already resolved to record IDs. Drawn by generateNovelIllustrations in a separate request, then cleared.",
      "items": {
        "type": "object",
        "properties": {
          "after_paragraph": {
            "type": "number"
          },
          "caption": {
            "type": "string"
          },
          "scene": {
            "type": "string"
          },
          "person_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "narrative_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "shows_user": {
            "type": "boolean"
          },
          "depicted_ages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "age": {
                  "type": "number"
                }
              }
            }
          },
          "location_id": {
            "type": "string"
          },
          "location_label": {
            "type": "string"
          },
          "zone_name": {
            "type": "string"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "novel_id",
    "chapter_number",
    "content"
  ]
}