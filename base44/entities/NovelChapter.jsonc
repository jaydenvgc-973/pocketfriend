{
  "name": "NovelChapter",
  "type": "object",
  "description": "One generated chapter of a novel, with its own prose and illustrations. Novel-owned record only.",
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "properties": {
    "novel_id": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "chapter_number": {
      "type": "number"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "Chapter prose. Paragraphs are separated by blank lines; illustrations are anchored by paragraph index."
    },
    "summary": {
      "type": "string",
      "description": "Short continuity summary used when writing later chapters"
    },
    "direction": {
      "type": "string",
      "description": "User direction supplied for this chapter, if any"
    },
    "word_count": {
      "type": "number"
    },
    "illustrations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          },
          "after_paragraph": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "illustration_specs": {
      "type": "array",
      "description": "Plates chosen by the writer, with their people and place already resolved to record IDs. Drawn by generateNovelIllustrations in a separate request, then cleared.",
      "items": {
        "type": "object",
        "properties": {
          "after_paragraph": {
            "type": "number"
          },
          "caption": {
            "type": "string"
          },
          "scene": {
            "type": "string"
          },
          "person_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "narrative_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "shows_user": {
            "type": "boolean"
          },
          "depicted_ages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "age": {
                  "type": "number"
                }
              }
            }
          },
          "location_id": {
            "type": "string"
          },
          "location_label": {
            "type": "string"
          },
          "zone_name": {
            "type": "string"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "novel_id",
    "chapter_number",
    "content"
  ]
}