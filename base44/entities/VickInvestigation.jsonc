{
  "name": "VickInvestigation",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string",
      "description": "Account this investigation belongs to. Primary ownership field. Required."
    },
    "title": {
      "type": "string",
      "description": "Short human-readable description of what is being investigated."
    },
    "description": {
      "type": "string",
      "description": "Full description of the investigation scope, evidence sources, and systems being reviewed."
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "investigating",
        "awaiting_evidence",
        "monitoring",
        "findings_ready",
        "delivered",
        "archived"
      ],
      "default": "queued",
      "description": "Lifecycle state. Progresses: queued \u2192 investigating \u2192 findings_ready \u2192 delivered \u2192 archived. Critical issues stop at delivered until user dismisses. Non-critical auto-archive after delivery."
    },
    "resolution": {
      "type": "string",
      "enum": [
        "resolved",
        "confirmed_defect",
        "confirmed_data_issue",
        "confirmed_system_issue",
        "user_action_required",
        "monitoring_required",
        "unable_to_verify"
      ],
      "description": "Final classification. Required before archiving. Set by Vick when delivering findings."
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "normal",
        "low"
      ],
      "default": "normal",
      "description": "Priority level. Critical investigations remain in active queue until user dismisses."
    },
    "findings": {
      "type": "string",
      "description": "Full findings text. Written at the same moment the message is delivered."
    },
    "findings_read": {
      "type": "boolean",
      "default": false,
      "description": "True once the user has opened and reviewed the findings."
    },
    "findings_delivered": {
      "type": "boolean",
      "default": false,
      "description": "True once a message containing findings has been saved to the Vick conversation."
    },
    "dismissed": {
      "type": "boolean",
      "default": false,
      "description": "True when user explicitly dismisses a critical investigation. Allows it to archive."
    },
    "dismissed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the user dismissed this investigation."
    },
    "conversation_id": {
      "type": "string",
      "description": "Vick conversation ID findings were delivered to."
    },
    "vick_character_id": {
      "type": "string",
      "description": "Vick's character ID \u2014 used to route finding messages."
    },
    "source_message_id": {
      "type": "string",
      "description": "ID of the user message that triggered this investigation."
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When Vick began actively working on this."
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time",
      "description": "When findings message was written to the conversation."
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this investigation was moved to archive."
    },
    "requires_user_input": {
      "type": "boolean",
      "default": false,
      "description": "True when Vick is blocked and needs more information from the user."
    },
    "user_input_prompt": {
      "type": "string",
      "description": "What Vick needs the user to provide or clarify."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Classification tags: travel, sleep, location, financial, character, memory, etc."
    }
  },
  "required": [
    "owner_email",
    "title",
    "status"
  ]
}