{
  "name": "Gathering Room Session Expiration",
  "description": "Per-session: when a GatheringRoomSession is created, compute the seconds until that session's authoritative expires_at, wait until that exact deadline, then invoke expireGatheringRoomSessions with session_id set to that same session's ID. No scanning, no polling, no recalculated 30-minute deadline, no additional fields.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "GatheringRoomSession"
    },
    "condition": "${ .trigger.data.expires_at != null }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "gathering_room_session_expiration",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "compute_wait": {
          "call": "compute_seconds_until",
          "with": {
            "target_iso": "${ .trigger.data.expires_at }"
          },
          "then": "wait_until_expiration",
          "x-base44": {
            "title": "Compute seconds until expires_at",
            "description": "Authoritative session deadline"
          }
        }
      },
      {
        "wait_until_expiration": {
          "wait": "PT${ .compute_wait.seconds | floor | tostring }S",
          "then": "expire_session",
          "x-base44": {
            "title": "Wait until expires_at",
            "description": "Durable delay to exact deadline"
          }
        }
      },
      {
        "expire_session": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "expireGatheringRoomSessions",
            "args": {
              "session_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Expire session",
            "description": "Per-session expiration via backend"
          }
        }
      }
    ]
  }
}