{
  "name": "Work Schedule Enforcement",
  "description": "Execution-only Workflow. Triggered by authoritative employment configuration changes (work_start_time, work_end_time, work_days, occupation_location_id, additional_occupation_locations, work_details). Each run handles ONE shift boundary: initial invoke \u2192 check \u2192 wait until next_execution_time \u2192 enforce invoke with expected_occurrence_time \u2192 check \u2192 retrigger \u2192 end. The retrigger updates work_details (an approved trigger field), which fires the entity trigger and starts a fresh run for the NEXT boundary. This achieves indefinite continuation through forward-only re-triggering \u2014 no backward transition (which the validator rejects as UNBOUNDED_CYCLE), no finite iteration count, no polling. The backend remains authoritative for multi-job resolution, shift resolution, location resolution, and canonical presence. If next_execution_time is null/empty or reason is stale_occurrence_superseded, the run ends without retriggering. Invocations pass event.entity_id (not characterId) so the backend detects entity-triggered invocation and uses service-role without user auth.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"work_start_time\") != null) or (.trigger.changed_fields | index(\"work_end_time\") != null) or (.trigger.changed_fields | index(\"work_days\") != null) or (.trigger.changed_fields | index(\"occupation_location_id\") != null) or (.trigger.changed_fields | index(\"additional_occupation_locations\") != null) or (.trigger.changed_fields | index(\"work_details\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Character"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "work_schedule_enforcement",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "invoke_1": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "enforceCharacterWorkSchedule",
            "args": {
              "event": {
                "entity_id": "${ .trigger.entity_id }"
              }
            }
          },
          "then": "check_1"
        }
      },
      {
        "check_1": {
          "switch": [
            {
              "when": "${ .invoke_1.next_execution_time != null and .invoke_1.next_execution_time != \"\" and .invoke_1.reason != \"stale_occurrence_superseded\" }",
              "then": "compute_1"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ]
        }
      },
      {
        "compute_1": {
          "call": "compute_seconds_until",
          "with": {
            "target_iso": "${ .invoke_1.next_execution_time }"
          },
          "then": "wait_1"
        }
      },
      {
        "wait_1": {
          "wait": "PT${ .compute_1.seconds | floor | tostring }S",
          "then": "invoke_2"
        }
      },
      {
        "invoke_2": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "enforceCharacterWorkSchedule",
            "args": {
              "event": {
                "entity_id": "${ .trigger.entity_id }"
              },
              "expected_occurrence_time": "${ .invoke_1.next_execution_time }"
            }
          },
          "then": "check_2"
        }
      },
      {
        "check_2": {
          "switch": [
            {
              "when": "${ .invoke_2.next_execution_time != null and .invoke_2.next_execution_time != \"\" and .invoke_2.reason != \"stale_occurrence_superseded\" }",
              "then": "retrigger"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ]
        }
      },
      {
        "retrigger": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "retriggerWorkScheduleWorkflow",
            "args": {
              "character_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}