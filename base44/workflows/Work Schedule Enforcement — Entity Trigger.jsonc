{
  "name": "Work Schedule Enforcement",
  "description": "Execution-only Workflow. Triggered by authoritative employment configuration changes (work_start_time, work_end_time, work_days, occupation_location_id, additional_occupation_locations, work_details). Invokes enforceCharacterWorkSchedule for the triggered character, receives next_execution_time, waits until that exact occurrence, re-invokes with that exact value as expected_occurrence_time, and continues the deadline cycle. The backend remains authoritative for multi-job resolution, shift resolution, location resolution, and canonical presence. The continuation chain is unrolled into a finite sequence of unique-named iterations (no cycles) due to platform cycle detection. If the chain exhausts all iterations, a final invocation is performed and the workflow ends; the next employment config change starts a new instance.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"work_start_time\") != null) or (.trigger.changed_fields | index(\"work_end_time\") != null) or (.trigger.changed_fields | index(\"work_days\") != null) or (.trigger.changed_fields | index(\"work_details\") != null) or (.trigger.changed_fields | index(\"occupation_location_id\") != null) or (.trigger.changed_fields | index(\"current_work_location_id\") != null) or (.trigger.changed_fields | index(\"additional_occupation_locations\") != null) or (.trigger.changed_fields | index(\"occupation_location_name\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Character"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "work_schedule_enforcement",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "invoke_1": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "enforceCharacterWorkSchedule",
            "args": {
              "characterId": "${ .trigger.entity_id }"
            }
          },
          "then": "check_1"
        }
      },
      {
        "check_1": {
          "switch": [
            {
              "when": "${ .invoke_1.next_execution_time != null and .invoke_1.next_execution_time != \"\" and .invoke_1.reason != \"stale_occurrence_superseded\" }",
              "then": "compute_1"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ]
        }
      },
      {
        "compute_1": {
          "call": "compute_seconds_until",
          "with": {
            "target_iso": "${ .invoke_1.next_execution_time }"
          },
          "then": "wait_1"
        }
      },
      {
        "wait_1": {
          "wait": "PT${ .compute_1.seconds | floor | tostring }S",
          "then": "invoke_2"
        }
      },
      {
        "invoke_2": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "enforceCharacterWorkSchedule",
            "args": {
              "characterId": "${ .trigger.entity_id }",
              "expected_occurrence_time": "${ .invoke_1.next_execution_time }"
            }
          },
          "then": "check_2"
        }
      },
      {
        "check_2": {
          "switch": [
            {
              "when": "${ .invoke_2.next_execution_time != null and .invoke_2.next_execution_time != \"\" and .invoke_2.reason != \"stale_occurrence_superseded\" }",
              "then": "compute_2"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ]
        }
      },
      {
        "compute_2": {
          "call": "compute_seconds_until",
          "with": {
            "target_iso": "${ .invoke_2.next_execution_time }"
          },
          "then": "wait_2"
        }
      },
      {
        "wait_2": {
          "wait": "PT${ .compute_2.seconds | floor | tostring }S",
          "then": "invoke_3"
        }
      },
      {
        "invoke_3": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "enforceCharacterWorkSchedule",
            "args": {
              "characterId": "${ .trigger.entity_id }",
              "expected_occurrence_time": "${ .invoke_2.next_execution_time }"
            }
          },
          "then": "check_3"
        }
      },
      {
        "check_3": {
          "switch": [
            {
              "when": "${ .invoke_3.next_execution_time != null and .invoke_3.next_execution_time != \"\" and .invoke_3.reason != \"stale_occurrence_superseded\" }",
              "then": "compute_3"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ]
        }
      },
      {
        "compute_3": {
          "call": "compute_seconds_until",
          "with": {
            "target_iso": "${ .invoke_3.next_execution_time }"
          },
          "then": "wait_3"
        }
      },
      {
        "wait_3": {
          "wait": "PT${ .compute_3.seconds | floor | tostring }S",
          "then": "invoke_4"
        }
      },
      {
        "invoke_4": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "enforceCharacterWorkSchedule",
            "args": {
              "characterId": "${ .trigger.entity_id }",
              "expected_occurrence_time": "${ .invoke_3.next_execution_time }"
            }
          },
          "then": "check_4"
        }
      },
      {
        "check_4": {
          "switch": [
            {
              "when": "${ .invoke_4.next_execution_time != null and .invoke_4.next_execution_time != \"\" and .invoke_4.reason != \"stale_occurrence_superseded\" }",
              "then": "compute_4"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ]
        }
      },
      {
        "compute_4": {
          "call": "compute_seconds_until",
          "with": {
            "target_iso": "${ .invoke_4.next_execution_time }"
          },
          "then": "wait_4"
        }
      },
      {
        "wait_4": {
          "wait": "PT${ .compute_4.seconds | floor | tostring }S",
          "then": "invoke_5"
        }
      },
      {
        "invoke_5": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "enforceCharacterWorkSchedule",
            "args": {
              "characterId": "${ .trigger.entity_id }",
              "expected_occurrence_time": "${ .invoke_4.next_execution_time }"
            }
          },
          "then": "check_5"
        }
      },
      {
        "check_5": {
          "switch": [
            {
              "when": "${ .invoke_5.next_execution_time != null and .invoke_5.next_execution_time != \"\" and .invoke_5.reason != \"stale_occurrence_superseded\" }",
              "then": "compute_5"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ]
        }
      },
      {
        "compute_5": {
          "call": "compute_seconds_until",
          "with": {
            "target_iso": "${ .invoke_5.next_execution_time }"
          },
          "then": "wait_5"
        }
      },
      {
        "wait_5": {
          "wait": "PT${ .compute_5.seconds | floor | tostring }S",
          "then": "final_invoke"
        }
      },
      {
        "final_invoke": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "enforceCharacterWorkSchedule",
            "args": {
              "characterId": "${ .trigger.entity_id }",
              "expected_occurrence_time": "${ .invoke_5.next_execution_time }"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}