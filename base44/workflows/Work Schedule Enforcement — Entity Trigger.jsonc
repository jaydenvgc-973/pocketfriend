{
  "name": "Work Schedule Enforcement",
  "description": "Execution-only Workflow. Fires when a character's authoritative employment configuration or presence status changes and runs enforceCharacterWorkSchedule immediately, which routes the character where the schedule says they belong, wakes them for a shift, and records the schedule's next established boundary. That recorded boundary is then waited on by the recurring boundary run, which enforces it \u2014 the boundary itself is the completion event and delivers the automatic narrative. No polling, no interval checks.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"work_start_time\") != null) or (.trigger.changed_fields | index(\"work_end_time\") != null) or (.trigger.changed_fields | index(\"work_days\") != null) or (.trigger.changed_fields | index(\"occupation_location_id\") != null) or (.trigger.changed_fields | index(\"additional_occupation_locations\") != null) or (.trigger.changed_fields | index(\"work_details\") != null) or (.trigger.changed_fields | index(\"resolved_presence_status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Character"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "work_schedule_enforcement",
      "version": "4.0",
      "namespace": "base44"
    },
    "do": [
      {
        "enforce": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "enforceCharacterWorkSchedule",
            "args": {
              "event": {
                "entity_id": "${ .trigger.entity_id }"
              },
              "system_mode": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Enforce schedule",
            "description": "Routes per schedule and records the next boundary"
          }
        }
      }
    ]
  }
}