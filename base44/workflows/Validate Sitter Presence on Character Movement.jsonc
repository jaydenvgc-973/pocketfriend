{
  "name": "Validate Sitter Presence on Character Movement",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"current_location_id\") != null) or (.trigger.changed_fields | index(\"current_home_location_id\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Character"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "validate_sitter_presence_on_character_movement",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "validateSitterPresenceOnLocationChange",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}