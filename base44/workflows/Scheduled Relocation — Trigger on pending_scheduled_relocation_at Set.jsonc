{
  "name": "Scheduled Relocation \u2014 Trigger on pending_scheduled_relocation_at Set",
  "description": "Registration event for the existing relocation pipeline. When a character's pending_scheduled_relocation_at is set or changed, it waits until that registered instant and then invokes processScheduledRelocations \u2014 the existing executor that routes the due move through enforceCharacterLocationPresence, the sole canonical writer. An already-due registration runs immediately. No new function, no recurring schedule, no polling: the delay is read from the relocation timestamp the app already stores.",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"pending_scheduled_relocation_at\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Character"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "scheduled_relocation_trigger_on_pending_scheduled_relocation_at_set",
      "version": "1.2",
      "namespace": "base44"
    },
    "do": [
      {
        "compute_wait": {
          "call": "compute_seconds_until",
          "with": {
            "target_iso": "${ .trigger.data.pending_scheduled_relocation_at }"
          },
          "then": "check_due",
          "x-base44": {
            "title": "Time until the move",
            "description": "From the registered time"
          }
        }
      },
      {
        "check_due": {
          "switch": [
            {
              "when": "${ (.compute_wait.seconds // 0) <= 0 }",
              "then": "run_process"
            },
            {
              "when": "${ true }",
              "then": "wait_until_due"
            }
          ],
          "x-base44": {
            "title": "Due already?",
            "description": "Runs now if past due"
          }
        }
      },
      {
        "wait_until_due": {
          "wait": "PT${ ((.compute_wait.seconds // 0 | floor) + 5) }S",
          "then": "run_process",
          "x-base44": {
            "title": "Wait for the move time",
            "description": "Ends a few seconds after"
          }
        }
      },
      {
        "run_process": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processScheduledRelocations",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Execute the relocation",
            "description": "Existing executor"
          }
        }
      }
    ]
  }
}