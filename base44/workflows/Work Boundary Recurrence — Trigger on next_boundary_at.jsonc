{
  "name": "Work Boundary Recurrence \u2014 Trigger on next_boundary_at",
  "description": "The work schedule's own boundary chain. Every time the schedule authority records the next established boundary, this run waits durably for that exact instant and then enforces it. The boundary run recomputes the following boundary, which records again and hands the next occurrence to a fresh run. Successive shift starts and shift ends therefore continue on their own \u2014 no polling, no repeated condition checks, and no dependence on any other event.",
  "trigger": {
    "condition": "${ .trigger.data.kind == \"work\" and (.trigger.changed_fields | index(\"next_boundary_at\") != null) and .trigger.data.next_boundary_at != null and .trigger.data.next_boundary_at != \"\" }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "WorkBoundaryLease"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "work_boundary_recurrence",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "compute": {
          "call": "compute_seconds_until",
          "with": {
            "target_iso": "${ .trigger.data.next_boundary_at }"
          },
          "then": "check",
          "x-base44": {
            "title": "Compute seconds to boundary",
            "description": "Duration of the durable wait"
          }
        }
      },
      {
        "check": {
          "switch": [
            {
              "when": "${ .compute.seconds > 1 }",
              "then": "pause",
              "x-base44": {
                "title": "Boundary is ahead"
              }
            },
            {
              "when": "${ true }",
              "then": "boundary"
            }
          ],
          "x-base44": {
            "title": "Is the boundary still ahead?",
            "description": "A boundary that already passed is enforced immediately"
          }
        }
      },
      {
        "pause": {
          "wait": "PT${ .compute.seconds | floor | tostring }S",
          "then": "boundary",
          "x-base44": {
            "title": "Wait for the boundary",
            "description": "Durable wait to the exact instant"
          }
        }
      },
      {
        "boundary": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "enforceCharacterWorkSchedule",
            "args": {
              "characterId": "${ .trigger.data.character_id }",
              "expected_occurrence_time": "${ .trigger.data.next_boundary_at }",
              "system_mode": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Enforce the boundary",
            "description": "Shift start or shift end, at its minute"
          }
        }
      }
    ]
  }
}