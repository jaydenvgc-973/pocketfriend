{
  "name": "Daily World Context Fetch",
  "description": "Runs at 4 AM ET. Fetches US news (politics, crime, economics), entertainment trends, top music artists, pop culture references, and weather. Global app state \u2014 all users access same world context daily.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_world_context_fetch",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "fetchDailyWorldContext",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}