{
  "name": "School Schedule Enforcement \u2014 Entity Trigger",
  "description": "Fires when a character's school/enrollment fields change (student_status, education_location_id, current_school_location_id, education_enrollments). Invokes enforceCharacterSchoolSchedule which evaluates the authoritative school schedule, routes the character to/from school via the canonical writer, and returns next_execution_time for the Workflow delay step. Replaces any polling-based school enforcement with an event-driven Workflow.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"student_status\") != null) or (.trigger.changed_fields | index(\"education_location_id\") != null) or (.trigger.changed_fields | index(\"current_school_location_id\") != null) or (.trigger.changed_fields | index(\"education_enrollments\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Character"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "school_schedule_enforcement_entity_trigger",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "enforceCharacterSchoolSchedule",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}