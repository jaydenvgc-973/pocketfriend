{
  "name": "School Schedule Enforcement \u2014 Entity Trigger",
  "description": "Fires when a character's school/enrollment fields or presence status change and runs enforceCharacterSchoolSchedule immediately, which routes the character to or from school per the authoritative schedule and records the schedule's next established boundary. That recorded boundary is then waited on by the recurring boundary run, which enforces it \u2014 the boundary itself is the completion event and delivers the automatic narrative. No polling, no interval checks.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"student_status\") != null) or (.trigger.changed_fields | index(\"education_location_id\") != null) or (.trigger.changed_fields | index(\"current_school_location_id\") != null) or (.trigger.changed_fields | index(\"education_enrollments\") != null) or (.trigger.changed_fields | index(\"resolved_presence_status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Character"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "school_schedule_enforcement_entity_trigger",
      "version": "4.0",
      "namespace": "base44"
    },
    "do": [
      {
        "enforce": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "enforceCharacterSchoolSchedule",
            "args": {
              "event": {
                "entity_id": "${ .trigger.entity_id }"
              }
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Enforce school schedule",
            "description": "Routes per schedule and records the next boundary"
          }
        }
      }
    ]
  }
}