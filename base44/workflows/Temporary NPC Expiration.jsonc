{
  "description": "Hourly: removes temporary NPCs spawned from Scenes once their 24-hour lifespan has passed, using the existing character deletion pathway. NPCs the user made permanent are no longer temporary and are never touched.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "temporary_npc_expiration",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "expire_temporary_npcs": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processDueCharacterDeletions",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Remove expired temporary NPCs",
            "description": "24-hour lifespan reached"
          }
        }
      }
    ]
  },
  "name": "Temporary NPC Expiration"
}