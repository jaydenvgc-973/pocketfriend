{
  "name": "Weekly Publication Generation",
  "description": "Generates the official weekly world publication edition every Sunday at 1:00 PM Eastern Time. Covers the previous complete 7-day period. Writes actual newspaper articles with a required headline image from completed Story Events, Community Events, and public records.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 17 * * 0",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_publication_generation",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateWeeklyPublication",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}