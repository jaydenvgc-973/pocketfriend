{
  "name": "VGC Towers Return-Home at 1 AM",
  "description": "Daily return-home block at 1:00 AM ET. Forces all npc_fictitious residents of VGC Towers back home to end the travel window and guarantee restoration to home base.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 5 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "vgc_towers_return_home_at_1_am",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "returnVGCResidentsHome",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}