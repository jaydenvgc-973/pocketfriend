{
  "name": "Monthly Recurring Expenses \u2014 1st of Month",
  "description": "Runs on the 1st of every month at 6:00 AM ET. Charges all recurring expenses (rent, utilities, personal bills) for each character. Handles off-app rent eviction if balance is insufficient.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
