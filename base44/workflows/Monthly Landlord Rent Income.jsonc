{
  "name": "Monthly Landlord Rent Income",
  "description": "Credits rent income to landlord/property owner characters on the 1st of every month. Separate from tenant rent charges (processHousingCosts). Scoped by owner_email \u2014 no created_by.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 13 1 * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "monthly_landlord_rent_income",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processLandlordRentIncome",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}